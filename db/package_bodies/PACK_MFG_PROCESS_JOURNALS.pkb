"                                                                            aj_jrnl_no                ,
"
"                                                                            aj_cre_by                 ,
"
"                                                                            aj_cre_date               ,
"
"                                                                            aj_upd_by                 ,
"
"                                                                            aj_upd_date               ,
"
"                                                                            aj_offset_doc_no          ,
"
"                                                                            aj_vou_type               ,
