"
"
"
"
"                                        FOR c_overhead1 IN c_overhead(v_res_cost_inc)
"
"                                        LOOP
"
"
"
"                                             BEGIN
"
"                                             SELECT moa_acct
"
"                                               INTO v_oh_acct
"
"                                               FROM mfg_oh_accts
"
"                                              WHERE moa_bu = p_bu
"
"                                                AND moa_cs_elmnt_id = c_overhead1.ohbs_sub_elmnt;
"
"                                                EXCEPTION
"
"                                                WHEN NO_DATA_FOUND THEN
"
"                                                   RAISE_APPLICATION_ERROR(-20999,'HRM' ||'Overhead account defined');
"
"                                                END;
"
"
"
"
"
"                BEGIN
"
"
"
"
"
"
"
"                             proc_find_cost_center (p_bu,
"
"                                                                           p_plnt,
"
"                                                                           NULL,
