"
"                                                                            func_find_process_desc(p_bu,p_plnt,cr0.ptp_proc_id,p_lang)              ,
"
"                                                                            NULL                ,
"
"                                                                            NULL              ,
"
"                                                                            NULL             ,
"
"                                                                            NULL,
"
"                                                                            NULL                 ,
"
"                                                                            NULL               ,
"
"                                                                            NULL                 ,
"
"                                                                            NULL               ,
"
"                                                                            p_reject_qty              ,
"
"                                                                            v_unit_cost              ,
"
"                                                                            v_unit_cost             ,
"
"                                                                            NULL        ,
"
"                                                                            'SFM'                   ,
"
"                                                                            'N'                 ,
"
"                                                                            NULL                ,
"
"                                                                            p_user                 ,
"
"                                                                            SYSDATE               ,
"
"                                                                            NULL                 ,
"
"                                                                            NULL               ,
"
"                                                                            NULL          ,
"
"                                                                            v_vou_type             ,
"
"                                                                            NULL                ,
"
"                                                                            p_trans_no                 ,
"
"                                                                            1         ,
"
