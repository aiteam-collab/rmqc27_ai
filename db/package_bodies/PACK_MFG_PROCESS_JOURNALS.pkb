"
"    END proc_cre_jrnl_from_cancel_insp;
"
"
"
"    PROCEDURE proc_cre_pprej_comp_wh_jrnls(
"
"                                            p_bu            VARCHAR2,
"
"                                            p_plnt            VARCHAR2,
"
"                                            p_comp_doc_no    VARCHAR2,
"
"                                            p_trans_no        VARCHAR2,
"
"                                            p_trans_date    DATE,
"
"                                            p_prod_ord_no    VARCHAR2,
"
"                                            p_bom_no        VARCHAR,
"
"                                            p_prod_id        VARCHAR2,
"
"                                            p_prod_rev        NUMBER,
"
"                                            p_comp_qty        NUMBER,
"
"                                            p_unit_cost        NUMBER,
"
"                                            p_lang            NUMBER,
"
"                                            p_user            VARCHAR2
"
"                                            )
"
"    IS
"
"    CURSOR c0
"
"      IS
"
"    SELECT ptp_oprn_seq_no,
"
"           ptp_oprn_id    ,
"
"           ptp_proc_id
"
"      FROM prod_transfer_process
"
"     WHERE ptp_bu         = p_bu
"
"       AND ptp_plnt     = p_plnt
"
"       AND ptp_trans_no = p_trans_no
"
"     ORDER BY ptp_oprn_seq_no;
"
"
"
"    CURSOR c1(c_warehouse VARCHAR2)
"
"      IS
"
"    SELECT store_gl_acct
"
"      FROM stores
"
"     WHERE store_bu = p_bu
"
"       AND store_id = c_warehouse;
"
"
"
"    CURSOR c2
"
"      IS
"
"    SELECT SUM(pts_qty * pts_unit_cost) pts_ext_cost
"
"      FROM prod_trans_scrap
"
"     WHERE pts_bu             = p_bu
"
"       AND pts_plnt         = p_plnt
"
"       AND pts_trans_no     = p_trans_no;
"
"       --AND pts_scrbyp_type     = 'S';
"
"
"
"    CURSOR c3(c_oprn_id VARCHAR2, c_proc_id VARCHAR2)
"
"      IS
"
"    SELECT pror_rcp_store,
"
"           pror_cons_store,
"
"           pror_ins_req
"
"      FROM (
"
"    SELECT pror_rcp_store,
"
"           pror_cons_store,
"
"           pror_ins_req
"
"      FROM prod_order_routing
"
"     WHERE pror_bu         = p_bu
"
"       AND pror_plnt     = p_plnt
"
"       AND pror_ord_no    = p_prod_ord_no
"
"       AND p_prod_ord_no IS NOT NULL
"
"       AND pror_oprn_id = c_oprn_id
"
"       AND pror_proc_id = c_proc_id
"
"    UNION ALL
"
"    SELECT rouln_rcp_store,
"
"           rouln_cons_store,
"
"           rouln_ins_req
"
"      FROM bom_hd,routing_ln
"
"     WHERE bomhd_bu         = rouln_bu
"
"       AND bomhd_plnt         = rouln_plnt
"
"       AND bomhd_bom_no     = rouln_bom_no
"
"       AND bomhd_bu         = p_bu
"
"       AND bomhd_plnt         = p_plnt
"
"       AND bomhd_prod_id     = p_prod_id
"
"       AND bomhd_prod_rev     = p_prod_rev
"
"       AND bomhd_bom_no     = p_bom_no
"
"       AND rouln_bu             = p_bu
"
"       AND rouln_plnt         = p_plnt
"
"       AND rouln_oprn_id     = c_oprn_id
"
"       AND rouln_proc_id     = c_proc_id
"
"       AND p_prod_ord_no     IS NULL
"
"       );
"
"
"
"    cr1        c1%ROWTYPE;
"
"    cr2        c2%ROWTYPE;
"
"    cr3        c3%ROWTYPE;
"
"
"
"    v_jrnl_trans_no         VARCHAR2(15);
"
"    v_jrnl_trans_seq_no     NUMBER;
"
"    v_dbt_lvl1                VARCHAR2(20);
"
"    v_dbt_lvl2                VARCHAR2(20);
"
"    v_dbt_lvl3                VARCHAR2(20);
"
"    v_dbt_lvl4                VARCHAR2(20);
"
"    v_dbt_lvl5                VARCHAR2(20);
"
"    v_dbt_lvl6                VARCHAR2(20);
"
"    v_dbt_cc_code                VARCHAR2(100);
"
"    v_dbt_acct                VARCHAR2(20);
"
"    v_crd_lvl1                VARCHAR2(20);
"
"    v_crd_lvl2                VARCHAR2(20);
"
"    v_crd_lvl3                VARCHAR2(20);
"
"    v_crd_lvl4                VARCHAR2(20);
"
"    v_crd_lvl5                VARCHAR2(20);
"
"    v_crd_lvl6                VARCHAR2(20);
"
"    v_crd_cc_code                VARCHAR2(100);
"
"    v_crd_acct                VARCHAR2(20);
"
"    v_mat_dbt_lvl1            VARCHAR2(20);
"
"    v_mat_dbt_lvl2            VARCHAR2(20);
"
"    v_mat_dbt_lvl3            VARCHAR2(20);
"
"    v_mat_dbt_lvl4            VARCHAR2(20);
"
"    v_mat_dbt_lvl5            VARCHAR2(20);
"
"    v_mat_dbt_lvl6            VARCHAR2(20);
"
"    v_mat_dbt_cc_code            VARCHAR2(100);
"
"    v_mat_dbt_acct            VARCHAR2(20);
"
"    v_oh_lvl1                VARCHAR2(20);
"
"    v_oh_lvl2                VARCHAR2(20);
"
"    v_oh_lvl3                VARCHAR2(20);
"
"    v_oh_lvl4                VARCHAR2(20);
"
"    v_oh_lvl5                VARCHAR2(20);
"
"    v_oh_lvl6                VARCHAR2(20);
"
"    v_oh_cc_code                VARCHAR2(20);
"
"    v_oh_lvl_prj            VARCHAR2(20);
"
"    v_oh_lvl_plnt              VARCHAR2(10);
"
"    v_tot_dbt_amount         NUMBER(17,5);
"
"    v_mat_tot_dbt_amount      NUMBER(17,5);
"
"    v_oh_tot_dbt_amount        NUMBER(17,5);
"
"    v_oh_tot_dbt_amount1      NUMBER(17,5);
"
"    v_prod_Desc1              VARCHAR2(150);
"
"    v_narr                    VARCHAR2(2000);
"
"    v_store_acct_plnt        VARCHAR2(50);
"
"    v_dbt_store_id            VARCHAR2(15);
"
"    v_crd_store_id            VARCHAR2(15);
"
"    v_acct_lvl_prj            VARCHAR2(20);
"
"                        v_crd_loc_id        VARCHAR2(10);
"
"                    v_dbt_loc_id        VARCHAR2(10);
"
"                    v_plnt_loc_id        VARCHAR2(10);
"
"                    V_COMP_PFX VARCHAR2(10);
"
"                    v_vou_type  varchar2(10);
"
"                    V_SUB_VOU_TYPE VARCHAR2(10);
"
"
"
"    BEGIN
"
"
"
"        /*SELECT aj_jrnl_trns_no
"
"          INTO v_jrnl_trans_no
"
"          FROM (
"
"        SELECT aj_jrnl_trns_no
"
"          FROM appl_journals
"
"         WHERE aj_bu         = p_bu
"
"           AND aj_plnt        = p_plnt
"
"           AND aj_vou_no    = p_trans_no
"
"           AND ROWNUM        = 1
"
"        UNION ALL
"
"        SELECT ajh_jrnl_trns_no
"
"          FROM appl_journals_hist
"
"         WHERE ajh_bu         = p_bu
"
"           AND ajh_plnt        = p_plnt
"
"           AND ajh_vou_no    = p_trans_no
"
"               )
"
"         WHERE ROWNUM        = 1;*/
"
"
"
"        --IF v_jrnl_trans_no IS NULL THEN
"
"           v_jrnl_trans_no := func_find_jrnl_trans_no(p_bu,p_user);
"
"        --END IF;
"
"
"
"
"
"        select pt_comp_pfx
"
"          into v_comp_pfx
"
"          FROM PROD_TRANSFER
"
"         WHERE PT_BU = P_BU
"
"           AND PT_PLNT = P_PLNT
"
"           AND PT_TRANS_NO  = P_TRANS_NO;
"
"
"
"
"
"                 SELECT apsta_vou_type,apsta_sub_type
"
"                                 INTO v_vou_type,v_sub_vou_type
"
"                                 FROM APPL_PFX_SUB_TYPES_ASSO
"
"                   WHERE  APSTA_PFX = V_COMP_PFX
"
"            AND APSTA_BU  = p_bu;
"
"
"
"    FOR cr0 IN c0
"
"    LOOP
"
"
"
"        OPEN c3(cr0.ptp_oprn_id,cr0.ptp_proc_id);
"
"        FETCH c3 INTO cr3;
"
"        CLOSE c3;
"
"
"
"        FOR cr_scrap IN (SELECT pts_scrap_id,
"
"                                pts_scrap_rev,
"
"                                pts_store_id,
"
"                                pts_oprn_id,
"
"                                pts_proc_id,
"
"                                pts_qty,
"
"                                pts_unit_cost ,
"
"                                pts_qty * pts_unit_cost pts_ext_rate
"
"                           FROM prod_trans_scrap
"
"                          WHERE pts_bu             = p_bu
"
"                            AND pts_plnt         = p_plnt
"
"                            AND pts_trans_no     = p_trans_no
"
"                            --AND pts_scrbyp_type = 'S'
"
"                        )
"
"        LOOP
"
"
"
"        v_dbt_store_id := cr_scrap.pts_store_id;
"
"
"
"        OPEN c1(v_dbt_store_id);
"
"        FETCH c1 INTO cr1;
"
"
"
"        IF (c1%NOTFOUND) OR (cr1.store_gl_acct IS NULL) THEN
"
"
"
"        RAISE_APPLICATION_ERROR(-20269,'ICM'|| 'Warehouse GL Account not found'||v_dbt_store_id||' ' || cr3.pror_rcp_store);
"
"
"
"        ELSE
"
"
"
"        proc_find_cost_center (p_bu,
"
"                               p_plnt,
"
"                               NULL,
"
"                               cr1.store_gl_acct,
"
"                               NULL,
"
"                               NULL,
"
"                               NULL,
"
"                               NULL,
"
"                               v_dbt_lvl1,
"
"                               v_dbt_lvl2,
"
"                               v_dbt_lvl3,
"
"                               v_dbt_lvl4,
"
"                               v_dbt_lvl5,
"
"                               v_dbt_lvl6,
"
"                               v_acct_lvl_prj ,--p_acct_lvl_prj,
"
"                               v_store_acct_plnt,
"
"                               v_dbt_cc_code,
"
"                               v_dbt_loc_id
"
"                               );
"
"
"
"        END IF;
"
"
"
"        CLOSE c1;
"
"
"
"        SELECT NVL(MAX(aj_jrnl_trns_seq_no),0) + 1
"
"          INTO v_jrnl_trans_seq_no
"
"          FROM appl_journals
"
"         WHERE aj_bu = p_bu
"
"           AND aj_plnt = p_plnt
"
"           AND aj_jrnl_trns_no = v_jrnl_trans_no;
"
"
"
"        INSERT INTO appl_journals(
"
"                                    aj_bu                     ,
"
"                                    aj_plnt                   ,
"
"                                    aj_jrnl_trns_no           ,
"
"                                    aj_jrnl_trns_seq_no       ,
"
"                                    aj_acctg_plnt             ,
"
"                                    aj_gl_lvl1                ,
"
"                                    aj_gl_lvl2                ,
"
"                                    aj_gl_lvl3                ,
"
"                                    aj_gl_lvl4                ,
"
"                                    aj_gl_lvl5                ,
"
"                                    aj_gl_lvl6                ,
"
"                                    aj_cc_code                ,
"
"                                    aj_gl_acct                ,
"
"                                    aj_gl_acct_desc           ,
"
"                                    aj_reference1             ,
"
"                                    aj_reference2             ,
"
"                                    aj_fc_db_amt              ,
"
"                                    aj_fc_cr_amt              ,
"
"                                    aj_bc_db_amt              ,
"
"                                    aj_bc_cr_amt              ,
"
"                                    aj_db_ex_rate             ,
"
"                                    aj_cr_ex_rate             ,
"
"                                    aj_jrnl_date              ,
"
"                                    aj_jrnl_year              ,
"
"                                    aj_jrnl_period            ,
"
"                                    aj_store_id               ,
"
"                                    aj_store_name             ,
"
"                                    aj_cls_id                 ,
"
"                                    aj_cls_desc               ,
"
"                                    aj_sub_cls_id             ,
"
"                                    aj_sub_cls_desc           ,
"
"                                    aj_prod_id                ,
"
"                                    aj_prod_rev               ,
"
"                                    aj_prod_desc1             ,
"
"                                    aj_tc_id                  ,
"
"                                    aj_tc_desc                ,
"
"                                    aj_suplr_id               ,
"
"                                    aj_suplr_name             ,
"
"                                    aj_cust_id                ,
"
"                                    aj_cust_name              ,
"
"                                    aj_area_id                ,
"
"                                    aj_area_desc              ,
"
"                                    aj_terr_id                ,
"
"                                    aj_terr_desc              ,
"
"                                    aj_bank_id                ,
"
"                                    aj_bank_name              ,
"
"                                    aj_fa_grp_id              ,
"
"                                    aj_fa_grp_desc            ,
"
"                                    aj_fa_id                  ,
"
"                                    aj_fa_desc                ,
"
"                                    aj_dept_id                ,
"
"                                    aj_dept_desc              ,
"
"                                    aj_proj_id                ,
"
"                                    aj_proj_desc              ,
"
"                                    aj_res_grp_id             ,
"
"                                    aj_res_grp_desc           ,
