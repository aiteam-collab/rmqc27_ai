"
"                                                                    func_find_process_desc(p_bu,p_plnt,cr0.ptp_proc_id,p_lang)              ,
"
"                                                                    NULL                ,
"
"                                                                    NULL              ,
"
"                                                                    NULL             ,
"
"                                                                    NULL           ,
"
"                                                                    NULL                 ,
"
"                                                                    NULL               ,
"
"                                                                    NULL                 ,
"
"                                                                    NULL               ,
"
"                                                                    p_reject_qty              ,
"
"                                                                    p_unit_cost              ,
"
"                                                                    p_unit_cost             ,
"
"                                                                    NULL        ,
"
"                                                                    'SFM'                   ,
"
"                                                                    'N'                 ,
"
"                                                                    NULL                ,
"
"                                                                    p_user                 ,
"
"                                                                    SYSDATE               ,
"
"                                                                    NULL                 ,
"
"                                                                    NULL               ,
"
"                                                                    NULL          ,
"
"                                                                    v_vou_type              ,
"
"                                                                    NULL                ,
"
"                                                                    p_trans_no                 ,
"
"                                                                    1            ,
"
"                                                                    NULL                 ,
"
"                                                                    NULL,
"
"                                                                    v_acct_lvl_prj,
"
"                                                                    v_plnt_loc_id,
"
"                                                                    v_plnt_loc_id,
"
"                                                                    v_sub_vou_type
"
"                                                                    );
"
"
"
"
"
"
"
"
"
"
"
"                                                                SELECT NVL(MAX(aj_jrnl_trns_seq_no),0) + 1
