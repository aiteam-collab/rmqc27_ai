"
"
"
"                    PROCEDURE proc_cre_jrnl_ocw_to_poins_wh(
"
"                                p_bu        VARCHAR2,
"
"                                p_plnt        VARCHAR2,
"
"                                p_comp_doc_no    VARCHAR2,
"
"                                p_trans_no    VARCHAR2,
"
"                                p_trans_date    DATE,
"
"                                p_prod_ord_no    VARCHAR2,
"
"                                p_bom_no    VARCHAR,
"
"                                p_prod_id    VARCHAR2,
"
"                                p_prod_rev    NUMBER,
"
"                                p_comp_qty    NUMBER,
"
"                                p_unit_cost    NUMBER,
"
"                                p_sf_code    VARCHAR2,
"
"                                p_sys_ls_no    NUMBER,
"
"                                p_lang        NUMBER,
"
"                                p_user        VARCHAR2
"
"                                                 )
"
"
"
"                            IS
"
"
"
"
"
"                            CURSOR c0
"
"                              IS
"
"                            SELECT ptp_oprn_seq_no,
"
"                                   ptp_oprn_id    ,
"
"                                   ptp_proc_id
"
"                              FROM prod_transfer_process
"
"                             WHERE ptp_bu = p_bu
"
"                               AND ptp_plnt = p_plnt
"
"                               AND ptp_trans_no = p_trans_no
"
"                             ORDER BY ptp_oprn_seq_no DESC;
"
"
"
"                            CURSOR c1(c_store_id VARCHAR2)
"
"                              IS
"
"                            SELECT -- store_acct_plnt,
"
"                                --store_gl_lvl1  ,
"
"                                --store_gl_lvl2  ,
"
"                            --    store_gl_lvl3  ,
"
"                            --    store_gl_lvl4  ,
"
"                                store_gl_acct   ,
"
"                                store_id,
"
"                                store_plnt_loc_id
"
"                               FROM stores
"
"                              WHERE store_bu = p_bu
"
"                                AND store_id = c_store_id;
"
"
"
"                            v_jrnl_trans_no     VARCHAR2(15);
"
"                            v_jrnl_trans_seq_no     NUMBER;
"
"                            v_dbt_lvl1            VARCHAR2(20);
"
"                            v_dbt_lvl2            VARCHAR2(20);
"
"                            v_dbt_lvl3            VARCHAR2(20);
"
"                            v_dbt_lvl4            VARCHAR2(20);
"
"                            v_dbt_lvl5            VARCHAR2(20);
"
"                            v_dbt_lvl6            VARCHAR2(20);
"
"                            v_dbt_cc_code       VARCHAR2(100);
"
"                            v_dbt_acct            VARCHAR2(20);
"
"                            v_dbt_plnt        VARCHAR2(10);
"
"                            v_crd_lvl1        VARCHAR2(20);
"
"                            v_crd_lvl2        VARCHAR2(20);
"
"                            v_crd_lvl3        VARCHAR2(20);
"
"                            v_crd_lvl4        VARCHAR2(20);
"
"                            v_crd_lvl5        VARCHAR2(20);
"
"                            v_crd_lvl6        VARCHAR2(20);
"
"                            v_crd_cc_code        VARCHAR2(20);
"
"                            v_crd_acct        VARCHAR2(20);
"
"                            v_crd_plnt        VARCHAR2(10);
"
"                            v_unit_cost        NUMBER(17,5);
"
"                            var_oprn_narr        VARCHAR2(4000);
"
"                            v_dbt_store_id        VARCHAR2(10);
"
"                            v_crd_store_id        VARCHAR2(10);
"
"                            cr0            c0%ROWTYPE;
"
"                            cr1            c1%ROWTYPE;
"
"                            v_prod_desc1        VARCHAR2(150);
"
"                            v_dbt_loc_id        VARCHAR2(10);
"
"                            v_crd_loc_id        VARCHAR2(10);
"
"
"
"v_acct_lvl_prj    VARCHAR2(20);
"
"v_oh_acct  varchar2(20);
"
"
"
"v_comp_pfx  VARCHAR2(10);
"
"v_vou_type  VARCHAR2(10);
"
"v_sub_vou_type VARCHAR2(10);
"
"
"
"
"
"
"
"                            BEGIN
"
"
"
"                                v_jrnl_trans_no := func_find_jrnl_trans_no(p_bu,p_user);
"
"
"
"
"
"                                SELECT pt_comp_pfx
"
"                                  INTO v_comp_pfx
"
"                                  FROM prod_transfer
"
"                                 WHERE pt_bu = p_bu
"
"                                   AND pt_plnt = p_plnt
"
"                                   AND pt_trans_no = p_trans_no;
"
"
"
"                                    SELECT apsta_vou_type,apsta_sub_type
"
"                                             INTO v_vou_type,v_sub_vou_type
"
"                                             FROM APPL_PFX_SUB_TYPES_ASSO
"
"                               WHERE  APSTA_PFX = v_comp_pfx
"
"            AND APSTA_BU  = p_bu;
"
"
"
"
"
"                                OPEN c0;
"
"                                FETCH c0 INTO cr0;
"
"                                CLOSE c0;
"
"
"
"                                v_prod_desc1 := func_find_prod_qry_desc(p_bu,p_prod_id,p_prod_rev,p_lang);
"
"
"
"                                SELECT LISTAGG(ptp_oprn_id ||'-'||
"
"                                func_find_mfg_oper_desc(ptp_bu,ptp_plnt,ptp_oprn_id,1),',')
"
"                                WITHIN GROUP (ORDER BY ptp_oprn_id)
"
"                                  INTO var_oprn_narr
"
"                                  FROM prod_transfeR_process
"
"                                 WHERE ptp_bu = p_bu
"
"                                   AND ptp_plnt = p_plnt
"
"                                      AND ptp_trans_no = p_trans_no;
"
"
"
"                                OPEN c1(v_dbt_store_id);
"
"                                FETCH c1 INTO cr1;
"
"                                IF cr1.store_gl_acct IS NULL THEN
"
"                                     RAISE_APPLICATION_ERROR(-20269,'ICM'|| 'Warehouse GL Account not found'|| v_dbt_store_id|| ' '||cr1.store_id);
"
"                                 ELSE
"
"
"
"                                v_dbt_store_id := func_find_store_fr_type(p_bu,p_plnt,cr1.store_plnt_loc_id,'P');
"
"                                v_crd_store_id := func_find_store_fr_type(p_bu,p_plnt,cr1.store_plnt_loc_id,'O');
"
"
"
"                                         proc_find_cost_center (p_bu,
"
"                                                                p_plnt,
"
"                                                                NULL,
"
"                                                                cr1.store_gl_acct,
"
"                                                                NULL,
"
"                                                                NULL,
"
"                                                                NULL,
"
"                                                                NULL,
"
"                                                                v_dbt_lvl1,
"
"                                                                v_dbt_lvl2,
"
"                                                                v_dbt_lvl3,
"
"                                                                v_dbt_lvl4,
"
"                                                                v_dbt_lvl5,
"
"                                                                v_dbt_lvl6,
"
"                                                                v_acct_lvl_prj ,--p_acct_lvl_prj,
"
"                                                                v_dbt_plnt,
"
"                                                                v_dbt_cc_code,
"
"                                                                v_dbt_loc_id
"
"                                                                );
"
"
"
"                                    -- v_dbt_lvl1 := cr1.store_gl_lvl1;
"
"                                   --  v_dbt_lvl2 := cr1.store_gl_lvl2;
"
"                                   --  v_dbt_lvl3    := cr1.store_gl_lvl3;
"
"                                   --  v_dbt_lvl4 := cr1.store_gl_lvl4;
"
"                                     v_dbt_acct := cr1.store_gl_acct;
"
"                                   --  v_dbt_plnt := cr1.store_acct_plnt;
"
"                                 END IF;
"
"                                 CLOSE c1;
"
"
"
"                                 OPEN c1(v_crd_store_id);
"
"                                FETCH c1 INTO cr1;
"
"                                IF cr1.store_gl_acct IS NULL  THEN
"
"                                            RAISE_APPLICATION_ERROR(-20269,'ICM'|| 'Warehouse GL Account not found'||v_crd_store_id||' '|| cr1.store_id);
"
"                                 ELSE
"
"
"
"                                         proc_find_cost_center (p_bu,
"
"                                                                p_plnt,
"
"                                                                NULL,
"
"                                                                cr1.store_gl_acct,
"
"                                                                NULL,
"
"                                                                NULL,
"
"                                                                NULL,
"
"                                                                NULL,
"
"                                                                v_crd_lvl1,
"
"                                                                v_crd_lvl2,
"
"                                                                v_crd_lvl3,
"
"                                                                v_crd_lvl4,
"
"                                                                v_crd_lvl5,
"
"                                                                v_crd_lvl6,
"
"                                                                v_acct_lvl_prj ,--p_acct_lvl_prj,
"
"                                                                v_crd_plnt,
"
"                                                                v_crd_cc_code,
"
"                                                                v_crd_loc_id
"
"                                                                );
"
"
"
"                                --     v_crd_lvl1 := cr1.store_gl_lvl1;
"
"                                  --   v_crd_lvl2 := cr1.store_gl_lvl2;
"
"                                  --   v_crd_lvl3    := cr1.store_gl_lvl3;
"
"                                  --   v_crd_lvl4 := cr1.store_gl_lvl4;
"
"                                     v_crd_acct := cr1.store_gl_acct;
"
"                                  --   v_crd_plnt := cr1.store_acct_plnt;
"
"                                 END IF;
"
"                                 CLOSE c1;
"
"
"
"                                 v_unit_cost := func_find_sfg_unitcost(p_bu,p_prod_id,p_prod_rev,v_crd_store_id,p_prod_ord_no,p_sf_code,p_sys_ls_no);
"
"
"
"
"
"
"
"
"
"                                 SELECT NVL(MAX(aj_jrnl_trns_seq_no),0) + 1
"
"                                   INTO v_jrnl_trans_seq_no
"
"                                   FROM appl_journals
"
"                                  WHERE aj_bu = p_bu
"
"                                    AND aj_plnt = p_plnt
"
"                                    AND aj_jrnl_trns_no = v_jrnl_trans_no;
"
"
"
