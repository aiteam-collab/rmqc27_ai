"
"
"
"
"
"
"
"                                                     CURSOR c1(c_store_id VARCHAR2)
"
"                                                       IS
"
"                                                      SELECT store_id,
"
"                                                           --  store_gl_lvl1,
"
"                                                           --  store_gl_lvl2,
"
"                                                          --   store_gl_lvl3,
"
"                                                          --   store_gl_lvl4,
"
"                                                             store_gl_acct
"
"                                                           --  store_acct_plnt
"
"                                                        FROM stores
"
"                                                       WHERE store_bu = p_bu
"
"                                                         AND store_id = c_store_id;
"
"
"
"                                                        cr1    c1%ROWTYPE;
"
"
"
"
"
"                                                        v_jrnl_trans_no VARCHAR2(15);
"
"                                                        v_jrnl_trans_seq_no NUMBER := 0;
"
"
"
