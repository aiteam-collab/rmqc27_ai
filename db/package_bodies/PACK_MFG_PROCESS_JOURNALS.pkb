"
"
"
"
"
"                                                                                                                    OPEN c5(cr0.ptp_oprn_id);
"
"                                                                                                                    FETCH c5 INTO cr5;
"
"                                                                                                                    IF c5%FOUND AND cr5.pts_ext_cost > 0 THEN
"
"
"
"                                                                                                                    OPEN c4(cr0.ptp_oprn_id,cr0.ptp_proc_id);
"
"                                                                                                                    FETCH c4 INTO cr4;
"
"                                                                                                                    CLOSE c4;
