CREATE OR REPLACE
"PACKAGE BODY pack_mfg_process_journals
"
"IS
"
"    PROCEDURE proc_cre_labour_oprn_comp_jrnl(
"
"                    p_bu        VARCHAR2,
"
"                    p_plnt        VARCHAR2,
"
"                    p_comp_doc_no    VARCHAR2,
"
"                    p_trans_no    VARCHAR2,
"
"                    p_trans_date    DATE,
"
"                    p_prod_ord_no    VARCHAR2,
"
"                    p_bom_no    VARCHAR,
"
"                    p_prod_id    VARCHAR2,
"
"                    p_prod_rev    NUMBER,
"
"                    p_comp_qty    NUMBER,
"
"                    p_unit_cost    NUMBER,
"
"                    p_lang        NUMBER,
"
"                    p_user        VARCHAR2
"
"                    )
"
"
"
"                    IS
"
"                    CURSOR c0
"
"                      IS
"
"                    SELECT ptp_oprn_seq_no,
"
"                           ptp_oprn_id    ,
"
"                           ptp_proc_id  ,
"
"                           pt_loc_id,
"
"                           ( SELECT prohd_type
"
"                             FROM prod_order_hd
"
"                            WHERE prohd_bu = pt_bu
"
"                           AND prohd_plnt = pt_plnt
"
"                           AND prohd_ord_no = pt_prod_ord_no
"
"                           AND prohd_prod_id = pt_prod_id
"
"                           AND prohd_prod_rev = pt_prod_rev )vou_type
"
"                      FROM prod_transfer_process,
"
"                           prod_transfer
"
"                     WHERE ptp_bu = pt_bu
"
"                       AND ptp_plnt = pt_plnt
"
"                       AND ptp_trans_no = pt_trans_no
"
"                       AND ptp_bu = p_bu
"
"                       AND ptp_plnt = p_plnt
"
"                       AND ptp_trans_no = p_trans_no
"
"                     ORDER BY ptp_oprn_seq_no;
"
"
"
"                    CURSOR c1(c_dept_id VARCHAR2, c_oprn_id VARCHAR2)
"
"                      IS
"
"                    SELECT ptsru_bu,
"
"                           ptsru_plnt,
"
"                           ptsru_dept_id,
"
"                           ptsru_oprn_id,
"
"                           ptsru_res_grp,
"
"                           mfgrg_desc1,
"
"                           mfgrg_res_type,
"
"                           mfgrg_ac_lvl1,
"
"                           mfgrg_ac_lvl2,
"
"                           mfgrg_ac_lvl3,
"
"                           mfgrg_ac_lvl4,
"
"                           mfgrg_ac_lvl5   ,
"
"                           mfgrg_ac_lvl6   ,
"
"                           mfgrg_cc_code ,
"
"                           mfgrg_current_acct,
"
"                           mfgrg_acct_plnt,
"
"                           ptsru_usg,
"
"                           ptsru_unit_rate,
"
"                           ext_rate,
"
"                           mfgrg_ac_lvl_prj
"
"                       FROM(
"
"                    SELECT ptsru_bu,
"
"                           ptsru_plnt,
"
"                           ptsru_dept_id,
"
"                           ptsru_oprn_id,
"
"                           ptsru_res_grp,
"
"                           mfgrg_desc1,
"
"                           mfgrg_res_type,
"
"                           mfgrg_ac_lvl1          ,
"
"                           mfgrg_ac_lvl2          ,
"
"                           mfgrg_ac_lvl3          ,
"
"                           mfgrg_ac_lvl4          ,
"
"                           mfgrg_ac_lvl5   ,
"
"                           mfgrg_ac_lvl6   ,
"
"                           mfgrg_cc_code ,
"
"                           mfgrg_current_acct,
"
"                           mfgrg_acct_plnt,
"
"                           ptsru_usg              ,
"
"                           ptsru_unit_rate        ,
"
"                           (ptsru_usg * ptsru_unit_rate) ext_rate,
"
"                           mfgrg_ac_lvl_prj
"
"                      FROM prod_trns_std_res_usage,
"
"                           mfg_res_groups
"
"                     WHERE ptsru_bu = mfgrg_bu
"
"                       AND ptsru_plnt = mfgrg_plnt
"
"                       AND ptsru_res_grp = mfgrg_grp_id
"
"                       AND ptsru_dept_id = c_dept_id
"
"                       AND ptsru_oprn_id = c_oprn_id
"
"                       AND ptsru_bu = p_bu
"
"                       AND ptsru_plnt = p_plnt
"
"                       AND ptsru_trans_no = p_trans_no
"
"                       AND func_find_resgrp_charge_type(mfgrg_bu,mfgrg_plnt,mfgrg_grp_id) = 'S'
"
"                    UNION ALL
"
"                    (SELECT ptru_bu,
"
"                           ptru_plnt,
"
"                           ptru_dept_id,
"
"                           ptru_oprn_id,
"
"                           mfgrg_grp_id,
"
"                           mfgr_name1,
"
"                           mfgr_res_type,
"
"                           NULL mfgr_ac_lvl1          ,
"
"                           NULL mfgr_ac_lvl2          ,
"
"                           NULL mfgr_ac_lvl3          ,
"
"                           NULL mfgr_ac_lvl4          ,
"
"                           NULL mfgr_ac_lvl5    ,
"
"                           NULL mfgr_ac_lvl6,
"
"                           NULL mfgr_cc_code,
"
"                           mfgr_acct,
"
"                           mfgr_acct_plnt,
"
"                           ptru_units      ,
"
"                           ptru_hrly_rate  ,
"
"                           ptru_extend_rate     ,
"
"                           mfgr_prj_lvl
"
"                      FROM prod_transfer_res_usage,
"
"                           mfg_resources,
"
"                           mfg_res_groups
"
"                     WHERE ptru_bu = mfgr_bu
"
"                       AND ptru_plnt = mfgr_plnt
"
"                       AND ptru_res_id = mfgr_res_id
"
"                       AND mfgr_bu = mfgrg_bu
"
"                       AND mfgr_plnt = mfgrg_plnt
"
"                       AND mfgr_group_id = mfgrg_grp_id
"
"                       AND ptru_bu = p_bu
"
"                       AND ptru_plnt = p_plnt
"
"                       AND ptru_trans_no = p_trans_no
"
"                       AND ptru_dept_id = c_dept_id
"
"                       AND ptru_oprn_id = c_oprn_id
"
"                       AND func_find_resgrp_charge_type(mfgrg_bu,mfgrg_plnt,mfgrg_grp_id) = 'A'
"
"                       ))
"
"                      ORDER BY ptsru_bu,
"
"                                  ptsru_plnt,
"
"                                  ptsru_res_grp,
"
"                                  ptsru_dept_id,
"
"                               ptsru_oprn_id;
"
"
"
"
"
"                    CURSOR c1_oh(c_dept_id VARCHAR2, c_oprn_id VARCHAR2)
"
"                      IS
"
"                    SELECT ptru_bu,ptru_plnt,ptru_dept_id,ptru_oprn_id,ptru_res_id,
"
"                           mfgr_name1,moa_cs_elmnt_id,moa_ac_plnt,
"
"                           moa_lvl1,
"
"                           moa_lvl2,
"
"                           moa_lvl3,
"
"                           moa_lvl4,
"
"                           moa_lvl5,
"
"                           moa_lvl6,
"
"                           moa_cc_code,
"
"                           moa_acct,mfgr_prj_lvl,
"
"                           ptru_units,ptru_hrly_rate,
"
"                           ptru_extend_rate
"
"                       FROM(
"
"                    SELECT ptru_bu,
"
"                           ptru_plnt,
"
"                           ptru_dept_id,
"
"                           ptru_oprn_id,
"
"                           ptru_res_id,
"
"                           mfgr_name1,
"
"                           moa_cs_elmnt_id,
"
"                           moa_ac_plnt,
"
"                           moa_lvl1,
"
"                           moa_lvl2,
"
"                           moa_lvl3,
"
"                           moa_lvl4,
"
"                           moa_lvl5,
"
"                           moa_lvl6,
"
"                           moa_cc_code,
"
"                           moa_acct,
"
"                           mfgr_prj_lvl,
"
"                           ptru_units,
"
"                           ptru_hrly_rate,
"
"                           ptru_extend_rate
"
"                       FROM(
"
"                    SELECT ptru_bu,
"
"                           ptru_plnt,
"
"                           ptru_dept_id,
"
"                           ptru_oprn_id,
"
"                           ptru_res_id,
"
"                           mfgr_name1,
"
"                           NULL moa_cs_elmnt_id,
"
"                           mfgr_acct_plnt moa_ac_plnt,
"
"                           mfgr_lvl1      moa_lvl1,
"
"                           mfgr_lvl2      moa_lvl2,
"
"                           mfgr_lvl3      moa_lvl3,
"
"                           mfgr_lvl4      moa_lvl4,
"
"                           mfgr_lvl5     moa_lvl5,
"
"                           mfgr_lvl6     moa_lvl6,
"
"                           mfgr_cc_code     moa_cc_code,
"
"                           mfgr_acct moa_acct,
"
"                           mfgr_prj_lvl    ,
"
"                           ptru_units      ,
"
"                           mroh_oh_rate ptru_hrly_rate  ,
"
"                           (mroh_oh_rate * ptru_units) ptru_extend_rate
"
"                      FROM prod_transfer_res_usage,
"
"                           mfg_resources,
"
"                           mfg_res_oh_rates
"
"                     WHERE ptru_bu = mfgr_bu
"
"                       AND ptru_plnt = mfgr_plnt
"
"                       AND ptru_res_id = mfgr_res_id
"
"                       AND mfgr_res_type = 'M'
"
"                       AND mfgr_bu = mroh_bu
"
"                       AND mfgr_plnt = mroh_plnt
"
"                       AND mfgr_res_id = mroh_res_id
"
"                       AND TRUNC(mroh_eff_date) <= TRUNC(SYSDATE)
"
"                       --AND func_find_year(p_bu,TRUNC(mroh_eff_date)) = func_find_year(p_bu,TRUNC(SYSDATE))
"
"                       AND ptru_bu = p_bu
"
"                       AND ptru_plnt = p_plnt
"
"                       AND ptru_trans_no = p_trans_no
"
"                       AND ptru_dept_id = c_dept_id
"
"                       AND ptru_oprn_id = c_oprn_id)
"
"                      ORDER BY ptru_bu,
"
"                                  ptru_plnt,
"
"                                  ptru_res_id,
"
"                                  ptru_dept_id,
"
"                               ptru_oprn_id)
"
"                     UNION ALL
"
"                     SELECT ptru_bu,ptru_plnt,ptru_dept_id,ptru_oprn_id,ptru_res_id,
"
"                            mfgr_name1,moa_cs_elmnt_id,moa_ac_plnt,
"
"                           moa_lvl1,
"
"                           moa_lvl2,
"
"                           moa_lvl3,
"
"                           moa_lvl4,
"
"                           moa_lvl5,
"
"                           moa_lvl6,
"
"                           moa_cc_code,
"
"                           moa_acct,mfgr_prj_lvl,ptru_units,ptru_hrly_rate,
"
"                            ptru_extend_rate
"
"                       FROM(
"
"                     SELECT ptru_bu,
"
"                           ptru_plnt,
"
"                           ptru_dept_id,
"
"                           ptru_oprn_id,
"
"                           ptru_res_id,
"
"                           mfgr_name1,
"
"                           moa_cs_elmnt_id,
"
"                           moa_ac_plnt,
"
"                           moa_lvl1,
"
"                           moa_lvl2,
"
"                           moa_lvl3,
"
"                           moa_lvl4,
"
"                           moa_lvl5,
"
"                           moa_lvl6,
"
"                           moa_cc_code,
"
"                           moa_acct,
"
"                           mfgr_prj_lvl,
"
"                           ptru_units,
"
"                           ptru_hrly_rate,
"
"                           ptru_extend_rate
"
"                       FROM(
"
"                    SELECT ptru_bu,
"
"                           ptru_plnt,
"
"                           ptru_dept_id,
"
"                           ptru_oprn_id,
"
"                           ptru_res_id,
"
"                           mfgr_name1,
"
"                           NULL moa_cs_elmnt_id,
"
"                           mfgr_acct_plnt moa_ac_plnt,
"
"                           mfgr_lvl1       moa_lvl1,
"
"                           mfgr_lvl2       moa_lvl2,
"
"                           mfgr_lvl3       moa_lvl3,
"
"                           mfgr_lvl4       moa_lvl4,
"
"                           mfgr_lvl5      moa_lvl5,
"
"                           mfgr_lvl6      moa_lvl6,
"
"                           mfgr_cc_code      moa_cc_code,
"
"                           mfgr_acct moa_acct,
"
"                           mfgr_prj_lvl    ,
"
"                           ptru_units      ,
"
"                           mroh_oh_rate ptru_hrly_rate  ,
"
"                           (mroh_oh_rate * ptru_units) ptru_extend_rate
"
"                      FROM prod_transfer_res_usage,
"
"                           mfg_resources,
"
"                           mfg_res_oh_rates
"
"                     WHERE ptru_bu = mfgr_bu
"
"                       AND ptru_plnt = mfgr_plnt
"
"                       AND ptru_res_id = mfgr_res_id
"
"                       AND mfgr_res_type = 'P'
"
"                       AND mfgr_bu = mroh_bu
"
"                       AND mfgr_plnt = mroh_plnt
"
"                       AND mfgr_res_id = mroh_res_id
"
"                       AND TRUNC(mroh_eff_date) <= TRUNC(SYSDATE)
"
"                       --AND func_find_year(p_bu,TRUNC(mroh_eff_date)) = func_find_year(p_bu,TRUNC(SYSDATE))
"
"                       AND ptru_bu = p_bu
"
"                       AND ptru_plnt = p_plnt
"
"                       AND ptru_trans_no = p_trans_no
"
"                       AND ptru_dept_id = c_dept_id
"
"                       AND ptru_oprn_id = c_oprn_id)
"
"                      ORDER BY ptru_bu,
"
"                                  ptru_plnt,
"
"                                  ptru_res_id,
"
"                                  ptru_dept_id,
"
"                               ptru_oprn_id);
"
"
"
"                    CURSOR c_oh_rate(c_oprn_id VARCHAR2)
"
"                      IS
"
"                    SELECT ohbs_sub_elmnt,
"
"                           ohbs_rate * p_comp_qty ext_rate
"
"                      FROM oh_basis_subelement
"
"                     WHERE ohbs_bu = p_bu
"
"                       AND ohbs_plnt = p_plnt
"
"                       AND ohbs_prod_id = p_prod_id
"
"                       AND ohbs_prod_rev = p_prod_rev
"
"                       AND ohbs_oprn_id  = c_oprn_id
"
"                       AND ohbs_status = 'A'
"
"                       AND NOT EXISTS (SELECT 1 FROM oh_resource_asso
"
"                                      WHERE ohra_bu = ohbs_bu
"
"                                        AND ohra_plnt = ohbs_plnt
"
"                                        AND ohra_trans_no = ohbs_trans_no);
"
"
"
"                    CURSOR c_oh_acct(c_element_id    VARCHAR2)
"
"                      IS
"
"                    SELECT moa_acct,
"
"                           moa_cs_elmnt_id
"
"                      FROM mfg_oh_accts
"
"                     WHERE moa_bu = p_bu
"
"                       AND moa_cs_elmnt_id = c_element_id;
"
"
"
"
"
"
"
"                    CURSOR c3(c_warehouse VARCHAR2)
"
"                      IS
"
"                    SELECT store_gl_acct,store_plnt_loc_id
"
"                      FROM stores
"
"                     WHERE store_bu = p_bu
"
"                       AND store_id = c_warehouse;
"
"
"
"
"
"
"
"                    CURSOR c4(c_oprn_id VARCHAR2, c_proc_id VARCHAR2)
"
"                      IS
"
"                    SELECT pror_rcp_store,pror_cons_store,pror_ins_req
"
"                      FROM (
"
"                    SELECT pror_rcp_store,pror_cons_store,pror_ins_req
"
"                      FROM prod_order_routing
"
"                     WHERE pror_bu = p_bu
"
"                       AND pror_plnt = p_plnt
"
"                       AND pror_ord_no = p_prod_ord_no
"
"                       AND p_prod_ord_no IS NOT NULL
"
"                       AND pror_oprn_id = c_oprn_id
"
"                       AND pror_proc_id = c_proc_id
"
"                    UNION ALL
"
"                    SELECT rouln_rcp_store,rouln_cons_store,rouln_ins_req
"
"                      FROM bom_hd,routing_ln
"
"                     WHERE bomhd_bu = rouln_bu
"
"                       AND bomhd_plnt = rouln_plnt
"
"                       AND bomhd_bom_no = rouln_bom_no
"
"                       AND bomhd_bu = p_bu
"
"                       AND bomhd_plnt = p_plnt
"
"                       AND bomhd_prod_id = p_prod_id
"
"                       AND bomhd_prod_rev = p_prod_rev
"
"                       AND bomhd_bom_no = p_bom_no
"
"                       AND rouln_bu = p_bu
"
"                       AND rouln_plnt = p_plnt
"
"                       AND rouln_oprn_id = c_oprn_id
"
"                       AND rouln_proc_id = c_proc_id
"
"                       AND p_prod_ord_no IS NULL);
"
"
"
"                      CURSOR c_mat(c_oprn_id VARCHAR2, c_proc_id VARCHAR2)
"
"                        IS
"
"                    SELECT ptmc_seq_no,ptmc_prod_id,ptmc_prod_rev,ptmc_store_id,
"
"                           store_gl_acct,store_plnt_loc_id,
"
"                           ext_cost
"
"                       FROM(
"
"                    SELECT ptmc_seq_no,ptmc_prod_id,ptmc_prod_rev,ptmc_store_id,
"
"                           store_gl_acct,store_plnt_loc_id,
"
"                           ext_cost
"
"                       FROM(
"
"                    SELECT ptmc_seq_no,ptmc_prod_id,ptmc_prod_rev,ptmc_store_id,
"
"                        store_gl_acct    ,  store_plnt_loc_id,
"
"                            (ptmc_cons_qty * ptmc_unit_cost) ext_cost
"
"                        FROM prod_transfer_mat_cons,
"
"                             stores
"
"                       WHERE ptmc_bu = store_bu
"
"                         AND ptmc_store_id = store_id
"
"                         AND ptmc_bu = p_bu
"
"                         AND ptmc_plnt = p_plnt
"
"                         AND ptmc_trans_no = p_trans_no
"
"                         AND ptmc_proc_id = c_proc_id
"
"                         AND ptmc_oprn_id = c_oprn_id
"
"                         AND ROUND((ptmc_cons_qty * ptmc_unit_cost),2) > 0
"
"                         AND func_find_prod_cust_flag(ptmc_bu,ptmc_prod_id,ptmc_prod_Rev) IN ('N')
"
"                         AND ptmc_mat_type NOT IN ('F')
"
"                          ORDER BY ptmc_seq_no)) WHERE ext_cost > 0;
"
"
"
"
"
"                          CURSOR c_sf_mat
"
"                           IS
"
"                          SELECT ptmc_seq_no,ptmc_prod_id,ptmc_prod_rev,ptmc_store_id,
"
"                               store_gl_acct,
"
"                               ext_cost
"
"                           FROM(
"
"                        SELECT ptmc_seq_no,ptmc_prod_id,ptmc_prod_rev,ptmc_store_id,
"
"                            store_gl_acct    ,
"
"                            SUM(ptmc_cons_qty * ptmc_unit_cost) ext_cost
"
"                             FROM prod_transfer_mat_cons,
"
"                             stores
"
"                           WHERE ptmc_bu = store_bu
"
"                             AND ptmc_store_id = store_id
"
"                             AND ptmc_bu = p_bu
"
"                             AND ptmc_plnt = p_plnt
"
"                             AND ptmc_trans_no = p_trans_no
"
"                             AND ptmc_mat_type  IN ('F')
"
"                             GROUP BY ptmc_seq_no,ptmc_prod_id,ptmc_prod_rev,ptmc_store_id,
"
"                            -- store_gl_lvl1,store_gl_lvl2,store_gl_lvl3,store_gl_lvl4,
"
"                             store_gl_acct
"
"                            -- store_acct_plnt
"
"                          ORDER BY ptmc_seq_no);
"
"
"
"
"
"                        cr3        c3%ROWTYPE;
"
"                     cr4        c4%ROWTYPE;
"
"                     c_sf_mat1    c_sf_mat%ROWTYPE;
"
"                     c1_oh1        c1_oh%ROWTYPE;
"
"                     c_oh_acct1    c_oh_acct%ROWTYPE;
"
"
"
"                      v_jrnl_trans_no     VARCHAR2(15);
"
"                      v_jrnl_trans_seq_no     NUMBER;
"
"                      v_dbt_lvl1        VARCHAR2(20);
"
"                      v_dbt_lvl2        VARCHAR2(20);
"
"                      v_dbt_lvl3        VARCHAR2(20);
"
"                      v_dbt_lvl4        VARCHAR2(20);
"
"                      v_dbt_lvl5        VARCHAR2(20);
"
"                      v_dbt_lvl6        VARCHAR2(20);
"
"                      v_dbt_cc_code        VARCHAR2(20);
"
"                      v_dbt_acct        VARCHAR2(20);
"
"                      v_mat_dbt_lvl1    VARCHAR2(20);
"
"                      v_mat_dbt_lvl2    VARCHAR2(20);
"
"                      v_mat_dbt_lvl3    VARCHAR2(20);
"
"                      v_mat_dbt_lvl4    VARCHAR2(20);
"
"                      v_mat_dbt_lvl5    VARCHAR2(20);
"
"                      v_mat_dbt_lvl6    VARCHAR2(20);
"
"                      v_mat_dbt_cc_code    VARCHAR2(20);
"
"                      v_mat_dbt_acct    VARCHAR2(20);
"
"                      v_oh_lvl1        VARCHAR2(20);
"
"                      v_oh_lvl2        VARCHAR2(20);
"
"                      v_oh_lvl3        VARCHAR2(20);
"
"                      v_oh_lvl4        VARCHAR2(20);
"
"                      v_oh_lvl5        VARCHAR2(20);
"
"                      v_oh_lvl6        VARCHAR2(20);
"
"                      v_oh_cc_code        VARCHAR2(20);
"
"                      v_oh_lvl_prj        VARCHAR2(20);
"
"                      v_oh_lvl_plnt      VARCHAR2(10);
"
"                      v_tot_dbt_amount     NUMBER(17,5);
"
"                      v_mat_tot_dbt_amount  NUMBER(17,5);
"
"                      v_oh_tot_dbt_amount    NUMBER(17,5);
"
"                      v_oh_tot_dbt_amount1  NUMBER(17,5);
"
"                      v_prod_Desc1      VARCHAR2(150);
"
"                      v_narr        VARCHAR2(2000);
"
"                      v_store_acct_plnt    VARCHAR2(50);
"
"                        v_dbt_store_id    VARCHAR2(15);
"
"                        v_sf_cons        NUMBER;
"
"                        v_sf_crd_cons        NUMBER;
"
"                      v_acct_lvl_prj    VARCHAR2(20);
"
"
"
"                      v_res_grp_lvl1 VARCHAR2(20);
"
"                      v_res_grp_lvl2 VARCHAR2(20);
"
"                      v_res_grp_lvl3 VARCHAR2(20);
"
"                      v_res_grp_lvl4 VARCHAR2(20);
"
"                      v_res_grp_lvl5 VARCHAR2(20);
"
"                      v_res_grp_lvl6 VARCHAR2(20);
"
"                      v_res_grp_cc_code    VARCHAR2(20);
"
"                      v_res_grp_prj     VARCHAR2(20);
"
"                      v_res_grp_plnt VARCHAR2(10);
"
"
"
"                      v_oh1_lvl1 VARCHAR2(20);
"
"                      v_oh1_lvl2 VARCHAR2(20);
"
"                      v_oh1_lvl3 VARCHAR2(20);
"
"                      v_oh1_lvl4 VARCHAR2(20);
"
"                      v_oh1_lvl5    VARCHAR2(20);
"
"                      v_oh1_lvl6    VARCHAR2(20);
"
"                      v_oh1_cc_code    VARCHAR2(20);
"
"                      v_oh1_prj     VARCHAR2(20);
"
"                      v_oh1_plnt VARCHAR2(10);
"
"
"
"                      v_sf_ord_lvl1 VARCHAR2(20);
"
"                      v_sf_ord_lvl2 VARCHAR2(20);
"
"                      v_sf_ord_lvl3 VARCHAR2(20);
"
"                      v_sf_ord_lvl4 VARCHAR2(20);
"
"                      v_sf_ord_lvl5    VARCHAR2(20);
"
"                      v_sf_ord_lvl6    VARCHAR2(20);
"
"                      v_sf_ord_cc_code    VARCHAR2(20);
"
"                      v_sf_ord_prj     VARCHAR2(20);
"
"                      v_sf_ord_plnt VARCHAR2(10);
"
"                      v_plnt_loc_id    VARCHAR2(10);
"
"                      v_dbt_loc_id     VARCHAR2(10);
"
"                      v_crd_loc_id    VARCHAR2(10);
"
"                      v_res_loc_id    VARCHAR2(10);
"
"                      v_comp_pfx    VARCHAR2(10);
"
"                      v_vou_type    VARCHAR2(10);
"
"                      v_sub_vou_type    VARCHAR2(10);
"
"
"
"
"
"                    BEGIN
"
"
"
"                       v_jrnl_trans_no := func_find_jrnl_trans_no(p_bu,p_user);
"
"
"
"                       v_sf_cons := 0;
"
"                       v_sf_crd_cons := 0;
"
"
"
"                       SELECT pt_comp_pfx
"
"                         INTO v_comp_pfx
"
"                         FROM prod_transfer
"
"                        WHERE pt_bu = p_bu
"
"                          AND pt_plnt = p_plnt
"
"                          AND pt_trans_no = p_trans_no;
"
"
"
"                       SELECT apsta_vou_type,apsta_sub_type
"
"              INTO v_vou_type,v_sub_vou_type
"
"              FROM APPL_PFX_SUB_TYPES_ASSO
"
"            WHERE APSTA_PFX = v_comp_pfx
"
"            AND APSTA_BU  = p_bu;
"
"
"
"                        FOR cr0 IN c0
"
"                        LOOP
"
"
"
"
"
"
"
"                                v_dbt_store_id := func_find_store_fr_type(p_bu,p_plnt,cr0.pt_loc_id,'Q');
"
"
"
"
"
"                                -- change dthe paramter v_store_id instead of cr4.pror_rcpt_store
"
"                                OPEN c3(v_dbt_store_id);
"
"                                FETCH c3 INTO cr3;
"
"
"
"                                IF  cr3.store_gl_acct IS NULL THEN
"
"
"
"                                        RAISE_APPLICATION_ERROR(-20269,'ICM'|| 'Warehouse GL Account not found'|| v_dbt_store_id||' ' ||cr4.pror_rcp_store);
"
"                                ELSE
"
"                                         proc_find_cost_center (p_bu,
"
"                                                                p_plnt,
"
"                                                                NULL,
"
"                                                                cr3.store_gl_acct,
"
"                                                                NULL,
"
"                                                                NULL,
"
"                                                                NULL,
"
"                                                                NULL,
"
"                                                                v_mat_dbt_lvl1,
"
"                                                                v_mat_dbt_lvl2,
"
"                                                                v_mat_dbt_lvl3,
"
"                                                                v_mat_dbt_lvl4,
"
"                                                                v_mat_dbt_lvl5,
"
"                                                                v_mat_dbt_lvl6,
"
"                                                                v_acct_lvl_prj ,
"
"                                                                v_store_acct_plnt,
"
"                                                                v_mat_dbt_cc_code,
"
"                                                                cr3.store_plnt_loc_id
"
"                                                                );
"
"
"
"
"
"                                          v_mat_dbt_acct := cr3.store_gl_acct;
"
"                                          v_plnt_loc_id     := cr3.store_plnt_loc_id;
"
"                                END IF;
"
"
"
"                                CLOSE c3;
"
"
"
"                                v_oh_tot_dbt_amount := 0;
"
"
"
"                                FOR c1_oh1 IN c1_oh(cr0.ptp_proc_id,cr0.ptp_oprn_id)
"
"                                LOOP
"
"                                    v_oh_tot_dbt_amount := v_oh_tot_dbt_amount + c1_oh1.ptru_extend_rate;
"
"                                END LOOP;
"
"
"
"                                --RAISE_APPLICATION_ERROR(-20999,'HRM' || 'v_oh_tot_dbt_amount '||v_oh_tot_dbt_amount);
"
"
"
"                                v_mat_tot_dbt_amount := 0;
"
"
"
"                                FOR c_mat1 IN c_mat(cr0.ptp_oprn_id,cr0.ptp_proc_id)
"
"                                LOOP
"
"                                    v_mat_tot_dbt_amount := v_mat_tot_dbt_amount + ROUND(c_mat1.ext_cost,func_find_appl_rnddigit(p_bu));
"
"                                    --ROUND(v_oh_tot_dbt_amount,func_find_appl_rnddigit(p_bu))
"
"                                END LOOP;
"
"
"
"
"
"                                IF v_sf_cons = 0 THEN
"
"                                   OPEN c_sf_mat;
"
"                                   FETCH c_sf_mat INTO c_sf_mat1;
"
"                                   CLOSE c_sf_mat;
"
"
"
"                                   v_mat_tot_dbt_amount := v_mat_tot_dbt_amount + NVL(c_sf_mat1.ext_cost,0);
"
"                                   v_sf_cons := 1;
"
"                                END IF;
"
"
"
"                                --raise_application_error(-20999,'HRM'  ||v_mat_tot_dbt_amount);
"
"
"
"
"
"                                FOR c1_oh2 IN c_oh_rate(cr0.ptp_oprn_id)
"
"                                LOOP
"
"                                    v_mat_tot_dbt_amount := v_mat_tot_dbt_amount + c1_oh2.ext_rate;
"
"                                END LOOP c_oh_rate;
"
"
"
"
"
"
"
"                                v_prod_desc1 := func_find_prod_qry_desc(p_bu,p_prod_id,p_prod_rev,p_lang);
"
"
"
"                                --RAISE_APPLICATION_ERROR(-20999,'HRM'||' ' ||v_oh_tot_dbt_amount||' ' ||v_mat_tot_dbt_amount);
"
"
"
"                                IF v_oh_tot_dbt_amount > 0 THEN
"
"
"
"
"
"
"
"                                    SELECT NVL(MAX(aj_jrnl_trns_seq_no),0) + 1
"
"                                      INTO v_jrnl_trans_seq_no
"
"                                      FROM appl_journals
"
"                                     WHERE aj_bu = p_bu
"
"                                       AND aj_plnt = p_plnt
"
"                                       AND aj_jrnl_trns_no = v_jrnl_trans_no;
"
"
"
"
"
"                                    INSERT INTO appl_journals(
"
"                                                aj_bu                     ,
"
"                                                aj_plnt                   ,
"
"                                                aj_jrnl_trns_no           ,
"
"                                                aj_jrnl_trns_seq_no       ,
"
"                                                aj_acctg_plnt             ,
"
"                                                aj_gl_lvl1                ,
"
"                                                aj_gl_lvl2                ,
"
"                                                aj_gl_lvl3                ,
"
"                                                aj_gl_lvl4                ,
"
"                                                aj_gl_lvl5,
"
"                                                aj_gl_lvl6,
"
"                                                aj_cc_code        ,
"
"                                                aj_gl_acct                ,
"
"                                                aj_gl_acct_desc           ,
"
"                                                aj_reference1             ,
"
"                                                aj_reference2             ,
"
"                                                aj_fc_db_amt              ,
"
"                                                aj_fc_cr_amt              ,
"
"                                                aj_bc_db_amt              ,
"
"                                                aj_bc_cr_amt              ,
"
"                                                aj_db_ex_rate             ,
"
"                                                aj_cr_ex_rate             ,
"
"                                                aj_jrnl_date              ,
"
"                                                aj_jrnl_year              ,
"
"                                                aj_jrnl_period            ,
"
"                                                aj_store_id               ,
"
"                                                aj_store_name             ,
"
"                                                aj_cls_id                 ,
"
"                                                aj_cls_desc               ,
"
"                                                aj_sub_cls_id             ,
"
"                                                aj_sub_cls_desc           ,
"
"                                                aj_prod_id                ,
"
"                                                aj_prod_rev               ,
"
"                                                aj_prod_desc1             ,
"
"                                                aj_tc_id                  ,
"
"                                                aj_tc_desc                ,
"
"                                                aj_suplr_id               ,
"
"                                                aj_suplr_name             ,
"
"                                                aj_cust_id                ,
"
"                                                aj_cust_name              ,
"
"                                                aj_area_id                ,
"
"                                                aj_area_desc              ,
"
"                                                aj_terr_id                ,
"
"                                                aj_terr_desc              ,
"
"                                                aj_bank_id                ,
"
"                                                aj_bank_name              ,
"
"                                                aj_fa_grp_id              ,
"
"                                                aj_fa_grp_desc            ,
"
"                                                aj_fa_id                  ,
"
"                                                aj_fa_desc                ,
"
"                                                aj_dept_id                ,
"
"                                                aj_dept_desc              ,
"
"                                                aj_proj_id                ,
"
"                                                aj_proj_desc              ,
"
"                                                aj_res_grp_id             ,
"
"                                                aj_res_grp_desc           ,
"
"                                                aj_res_id                 ,
"
"                                                aj_res_desc               ,
"
"                                                aj_emp_id                 ,
"
"                                                aj_emp_name               ,
"
"                                                aj_trans_qty              ,
"
"                                                aj_unit_cost              ,
"
"                                                aj_unit_price             ,
"
"                                                aj_source_doc_mode        ,
"
"                                                aj_appl                   ,
"
"                                                aj_status                 ,
"
"                                                aj_jrnl_no                ,
"
"                                                aj_cre_by                 ,
"
"                                                aj_cre_date               ,
"
"                                                aj_upd_by                 ,
"
"                                                aj_upd_date               ,
"
"                                                aj_offset_doc_no          ,
"
"                                                aj_vou_type               ,
"
"                                                aj_vou_pfx                ,
"
"                                                aj_vou_no                 ,
"
"                                                aj_vou_line_no            ,
"
"                                                aj_ref_no                 ,
"
"                                                aj_ref_date,
"
"                                                aj_gl_lvl_prj,
"
"                                                aj_gl_plnt_loc_id   ,
"
"                                                aj_sub_vou_type
"
"                                                )
"
"                                            VALUES(
"
"                                                p_bu                     ,
"
"                                                p_plnt                   ,
"
"                                                v_jrnl_trans_no           ,
"
"                                                v_jrnl_trans_seq_no       ,
"
"                                                v_store_acct_plnt             ,
"
"                                                v_mat_dbt_lvl1                ,
"
"                                                v_mat_dbt_lvl2                ,
"
"                                                v_mat_dbt_lvl3                ,
"
"                                                v_mat_dbt_lvl4                ,
"
"                                                v_mat_dbt_lvl5,
"
"                                                v_mat_dbt_lvl6,
"
"                                                v_mat_dbt_cc_code,
"
"                                                v_mat_dbt_acct                ,
"
"                                                func_find_gl_acct_desc(p_bu,v_mat_dbt_acct,p_lang)           ,
"
"                                                'Process Completion ('||p_trans_no||'/'||cr0.ptp_oprn_seq_no||'/'||cr0.ptp_oprn_id ||'/'||func_find_mfg_oper_desc(p_bu,p_plnt,cr0.ptp_oprn_id,p_lang)||')'             ,
"
"                                                'Process Completion'             ,
"
"                                                ROUND(v_oh_tot_dbt_amount,func_find_appl_rnddigit(p_bu))              ,
"
"                                                0              ,
"
"                                                ROUND(v_oh_tot_dbt_amount,func_find_appl_rnddigit(p_bu)),
"
"                                                0              ,
"
"                                                1             ,
"
"                                                1             ,
"
"                                                p_trans_date              ,
"
"                                                func_find_year(p_bu,p_trans_date)              ,
"
"                                                func_find_period(p_bu,p_trans_date)            ,
"
"                                                v_dbt_store_id               ,
"
"                                                func_find_store_desc(p_bu,v_dbt_store_id,p_lang)             ,
"
"                                                func_find_product_class(p_bu,p_plnt,p_prod_id,p_prod_rev)                 ,
"
"                                                func_find_class_desc(p_bu,func_find_product_class(p_bu,p_plnt,p_prod_id,p_prod_rev) ,p_lang)               ,
"
"                                                func_find_product_subclass(p_bu,p_plnt,p_prod_id,p_prod_rev)             ,
"
"                                                func_find_subclass_desc(p_bu,func_find_product_subclass(p_bu,p_plnt,p_prod_id,p_prod_rev) ,p_lang)           ,
"
"                                                p_prod_id                ,
"
"                                                p_prod_rev               ,
"
"                                                v_prod_desc1             ,
"
"                                                NULL                  ,
"
"                                                NULL                ,
"
"                                                NULL               ,
"
"                                                NULL             ,
"
"                                                NULL                ,
"
"                                                NULL              ,
"
"                                                NULL                ,
"
"                                                NULL              ,
"
"                                                NULL                ,
"
"                                                NULL              ,
"
"                                                NULL                ,
"
"                                                NULL              ,
"
"                                                NULL              ,
"
"                                                NULL            ,
"
"                                                NULL                  ,
"
"                                                NULL                ,
"
"                                                cr0.ptp_proc_id                ,
"
"                                                func_find_process_desc(p_bu,p_plnt,cr0.ptp_proc_id,p_lang)              ,
"
"                                                NULL                ,
"
"                                                NULL              ,
"
"                                                NULL             ,
"
"                                                NULL           ,
"
"                                                NULL                 ,
"
"                                                NULL               ,
"
"                                                NULL                 ,
"
"                                                NULL               ,
"
"                                                p_comp_qty              ,
"
"                                                p_unit_cost              ,
"
"                                                p_unit_cost             ,
"
"                                                NULL        ,
"
"                                                'SFM'                   ,
"
"                                                'N'                 ,
"
"                                                NULL                ,
"
"                                                p_user                 ,
"
"                                                SYSDATE               ,
"
"                                                NULL                 ,
"
"                                                NULL               ,
"
"                                                NULL          ,
"
"                                                v_vou_type             ,
"
"                                                NULL                ,
"
"                                                p_trans_no                 ,
"
"                                                1            ,
"
"                                                NULL                 ,
"
"                                                NULL,
"
"                                                v_acct_lvl_prj,
"
"                                                v_plnt_loc_id,
"
"                                                v_sub_vou_type
"
"                                                  );
"
"
"
"                                                  v_oh_tot_dbt_amount := 0;
"
"
"
"                                    END IF;
"
"
"
"
"
"
"
"
"
"                                        IF v_mat_tot_dbt_amount > 0 THEN
"
"
"
"
"
"
"
"                                        SELECT NVL(MAX(aj_jrnl_trns_seq_no),0) + 1
"
"                                          INTO v_jrnl_trans_seq_no
"
"                                          FROM appl_journals
"
"                                         WHERE aj_bu = p_bu
"
"                                           AND aj_plnt = p_plnt
"
"                                           AND aj_jrnl_trns_no = v_jrnl_trans_no;
"
"
"
"
"
"                                        INSERT INTO appl_journals(
"
"                                                    aj_bu                     ,
"
"                                                    aj_plnt                   ,
"
"                                                    aj_jrnl_trns_no           ,
"
"                                                    aj_jrnl_trns_seq_no       ,
"
"                                                    aj_acctg_plnt             ,
"
"                                                    aj_gl_lvl1                ,
"
"                                                    aj_gl_lvl2                ,
"
"                                                    aj_gl_lvl3                ,
"
"                                                    aj_gl_lvl4                ,
"
"                                                    aj_gl_lvl5        ,
"
"                                                    aj_gl_lvl6        ,
"
"                                                    aj_cc_code        ,
"
"                                                    aj_gl_acct                ,
"
"                                                    aj_gl_acct_desc           ,
"
"                                                    aj_reference1             ,
"
"                                                    aj_reference2             ,
"
"                                                    aj_fc_db_amt              ,
"
"                                                    aj_fc_cr_amt              ,
"
"                                                    aj_bc_db_amt              ,
"
"                                                    aj_bc_cr_amt              ,
"
"                                                    aj_db_ex_rate             ,
"
"                                                    aj_cr_ex_rate             ,
"
"                                                    aj_jrnl_date              ,
"
"                                                    aj_jrnl_year              ,
"
"                                                    aj_jrnl_period            ,
"
"                                                    aj_store_id               ,
"
"                                                    aj_store_name             ,
"
"                                                    aj_cls_id                 ,
"
"                                                    aj_cls_desc               ,
"
"                                                    aj_sub_cls_id             ,
"
"                                                    aj_sub_cls_desc           ,
"
"                                                    aj_prod_id                ,
"
"                                                    aj_prod_rev               ,
"
"                                                    aj_prod_desc1             ,
"
"                                                    aj_tc_id                  ,
"
"                                                    aj_tc_desc                ,
"
"                                                    aj_suplr_id               ,
"
"                                                    aj_suplr_name             ,
"
"                                                    aj_cust_id                ,
"
"                                                    aj_cust_name              ,
"
"                                                    aj_area_id                ,
"
"                                                    aj_area_desc              ,
"
"                                                    aj_terr_id                ,
"
"                                                    aj_terr_desc              ,
"
"                                                    aj_bank_id                ,
"
"                                                    aj_bank_name              ,
"
"                                                    aj_fa_grp_id              ,
"
"                                                    aj_fa_grp_desc            ,
"
"                                                    aj_fa_id                  ,
"
"                                                    aj_fa_desc                ,
"
"                                                    aj_dept_id                ,
"
"                                                    aj_dept_desc              ,
"
"                                                    aj_proj_id                ,
"
"                                                    aj_proj_desc              ,
"
"                                                    aj_res_grp_id             ,
"
"                                                    aj_res_grp_desc           ,
"
"                                                    aj_res_id                 ,
"
"                                                    aj_res_desc               ,
"
"                                                    aj_emp_id                 ,
"
"                                                    aj_emp_name               ,
"
"                                                    aj_trans_qty              ,
"
"                                                    aj_unit_cost              ,
"
"                                                    aj_unit_price             ,
"
"                                                    aj_source_doc_mode        ,
"
"                                                    aj_appl                   ,
"
"                                                    aj_status                 ,
"
"                                                    aj_jrnl_no                ,
"
"                                                    aj_cre_by                 ,
"
"                                                    aj_cre_date               ,
"
"                                                    aj_upd_by                 ,
"
"                                                    aj_upd_date               ,
"
"                                                    aj_offset_doc_no          ,
