"                                                                                    v_crd_lvl6              ,
"
"                                                                                    v_crd_cc_code              ,
"
"                                                                                    v_crd_acct               ,
"
"                                                                                    func_find_gl_acct_desc(p_bu,v_crd_acct,p_lang)           ,
"
"                                                                                    'STOCK DECREASE AT INSEPECTION WAREHOUSE ('||p_trans_no||'/'||var_oprn_narr||' '||')'               ,
"
"                                                                                    'STOCK DECREASE AT INSEPECTION WAREHOUSE'             ,
"
"                                                                                    0              ,
"
"                                                                                    (v_unit_cost * p_reject_qty)             ,
"
"                                                                                    0              ,
"
"                                                                                    (v_unit_cost * p_reject_qty)             ,
"
"                                                                                    1             ,
"
"                                                                                    1             ,
"
"                                                                                    p_trans_date              ,
"
"                                                                                    func_find_year(p_bu,p_trans_date)              ,
"
"                                                                                    func_find_period(p_bu,p_trans_date)            ,
"
"                                                                                    v_crd_store_id               ,
"
"                                                                                    func_find_store_desc(p_bu,v_crd_store_id,p_lang)             ,
"
"                                                                                    func_find_product_class(p_bu,p_plnt,p_prod_id,p_prod_rev)                               ,
"
"                                                                                    func_find_class_desc(p_bu,func_find_product_class(p_bu,p_plnt,p_prod_id,p_prod_rev) ,p_lang)               ,
"
"                                                                                    func_find_product_subclass(p_bu,p_plnt,p_prod_id,p_prod_rev)                          ,
"
"                                                                                    func_find_subclass_desc(p_bu,func_find_product_subclass(p_bu,p_plnt,p_prod_id,p_prod_rev) ,p_lang)           ,
"
"                                                                                    p_prod_id                ,
"
"                                                                                    p_prod_rev              ,
"
"                                                                                    v_prod_desc1            ,
"
"                                                                                    NULL                  ,
"
"                                                                                    NULL                ,
"
"                                                                                    NULL               ,
"
"                                                                                    NULL             ,
"
"                                                                                    NULL                ,
"
"                                                                                    NULL              ,
"
"                                                                                    NULL                ,
"
"                                                                                    NULL              ,
"
"                                                                                    NULL                ,
"
"                                                                                    NULL              ,
"
"                                                                                    NULL                ,
"
"                                                                                    NULL              ,
"
"                                                                                    NULL              ,
"
"                                                                                    NULL            ,
"
"                                                                                    NULL                  ,
"
"                                                                                    NULL                ,
"
"                                                                                    cr0.ptp_proc_id                ,
"
"                                                                                    func_find_process_qry_desc(p_bu,p_plnt,cr0.ptp_proc_id,p_lang)              ,
"
"                                                                                    NULL                ,
"
"                                                                                    NULL              ,
"
"                                                                                    NULL             ,
"
"                                                                                    NULL,
"
"                                                                                    NULL                 ,
"
"                                                                                    NULL               ,
"
"                                                                                    NULL                 ,
"
"                                                                                    NULL               ,
"
"                                                                                    p_reject_qty              ,
"
"                                                                                    v_unit_cost              ,
"
"                                                                                    v_unit_cost             ,
"
"                                                                                    NULL        ,
"
"                                                                                    'SFM'                   ,
"
"                                                                                    'N'                 ,
"
"                                                                                    NULL                ,
"
"                                                                                    p_user                 ,
"
"                                                                                    SYSDATE               ,
"
"                                                                                    NULL                 ,
"
"                                                                                    NULL               ,
"
"                                                                                    NULL          ,
"
"                                                                                    v_vou_type             ,
"
"                                                                                    NULL                ,
"
"                                                                                    p_trans_no                 ,
"
"                                                                                    1         ,
"
