"                                                            p_user                 ,
"
"                                                            SYSDATE               ,
"
"                                                            NULL                 ,
"
"                                                            NULL               ,
"
"                                                            NULL          ,
"
"                                                            v_vou_type            ,
"
"                                                            NULL                ,
"
"                                                            p_trans_no                 ,
"
"                                                            1         ,
"
"                                                            NULL                 ,
"
"                                                            NULL,
"
"                                                            v_acct_lvl_prj,
"
"                                                            v_crd_loc_id,
"
"                                                            v_crd_loc_id,
"
"                                                            v_sub_vou_type
"
"                                                             );
"
"
"
"
"
"
"
"
"
"
"
"
"
"
"
"
"
"
"
"
"
"
"
"                            END proc_cre_jrnl_ocw_to_poins_wh;
"
"
"
"
"
"                         PROCEDURE proc_cre_jrnl_nqc_ocw_to_rcpt(
"
"                                            p_bu        VARCHAR2,
"
"                                            p_plnt        VARCHAR2,
"
"                                            p_plnt_loc_id    VARCHAR2,
"
"                                            p_comp_doc_no    VARCHAR2,
"
"                                            p_trans_no    VARCHAR2,
"
"                                            p_trans_date    DATE,
"
"                                            p_prod_ord_no    VARCHAR2,
"
"                                            p_bom_no    VARCHAR,
"
"                                            p_prod_id    VARCHAR2,
"
"                                            p_prod_rev    NUMBER,
"
"                                            p_comp_qty    NUMBER,
"
"                                            p_accept_qty    NUMBER,
"
"                                            p_rej_qty    NUMBER,
"
"                                            p_rcpt_store_id    VARCHAR2,
"
"                                            p_rej_store_id    VARCHAR2,
"
"                                            p_unit_cost    NUMBER,
"
"                                            p_sf_code    VARCHAR2,
"
"                                            p_sys_ls_no    NUMBER,
"
"                                            p_lang        NUMBER,
"
"                                            p_user        VARCHAR2
"
"                                               )
"
"                                               IS
"
"
"
"
"
"
"
"                                               v_acpt_dbt_store     VARCHAR2(10);
"
"                                               v_rej_dbt_store      VARCHAR2(10);
"
"                                               v_crd_store        VARCHAR2(10);
"
"
"
"                                               v_dbt_ac_lvl1         VARCHAR2(20);
"
"                                               v_dbt_ac_lvl2        VARCHAR2(20);
"
"                                               v_dbt_ac_lvl3        VARCHAR2(20);
"
"                                               v_dbt_ac_lvl4        VARCHAR2(20);
"
"                                               v_dbt_ac_lvl5        VARCHAR2(20);
"
"                                               v_dbt_ac_lvl6        VARCHAR2(20);
"
"                                               v_dbt_ac_cc_code    VARCHAR2(100);
"
"                                               v_dbt_ac_acct        VARCHAR2(20);
"
"                                               v_dbt_ac_plnt        VARCHAR2(10);
"
"
"
"                                             v_dbt_rej_lvl1     VARCHAR2(20);
"
"                                             v_dbt_rej_lvl2        VARCHAR2(20);
"
"                                             v_dbt_rej_lvl3        VARCHAR2(20);
"
"                                             v_dbt_rej_lvl4        VARCHAR2(20);
"
"                                             v_dbt_rej_lvl5        VARCHAR2(20);
"
"                                             v_dbt_rej_lvl6        VARCHAR2(20);
"
"                                             v_dbt_rej_cc_code        VARCHAR2(20);
"
"                                             v_dbt_rej_acct        VARCHAR2(20);
"
"                                             v_dbt_rej_plnt        VARCHAR2(10);
"
"
"
"
"
"                                             v_crd_lvl1        VARCHAR2(20);
"
"                                             v_crd_lvl2        VARCHAR2(20);
"
"                                             v_crd_lvl3        VARCHAR2(20);
"
"                                             v_crd_lvl4        VARCHAR2(20);
"
"                                             v_crd_lvl5        VARCHAR2(20);
"
"                                             v_crd_lvl6        VARCHAR2(20);
"
"                                             v_crd_cc_code        VARCHAR2(20);
"
"                                             v_crd_acct        VARCHAR2(20);
"
"                                             v_crd_plnt        VARCHAR2(10);
"
"                                             v_jrnl_trans_no    VARCHAR2(15);
"
"                                             v_jrnl_trans_seq_no    NUMBER;
"
"                                             v_unit_cost        NUMBER(17,5);
"
"                                             v_prod_desc1        VARCHAR2(150);
"
"                                             var_oprn_narr        VARCHAR2(4000);
"
"                                             v_dbt_loc_id        VARCHAR2(10);
"
"                                             v_crd_loc_id        VARCHAR2(10);
"
"                                             v_res_loc_id        VARCHAR2(10);
"
"
"
"
"
"
"
"
"
"                                            CURSOR c0
"
"                                              IS
"
"                                            SELECT ptp_oprn_seq_no,
"
"                                                   ptp_oprn_id    ,
"
"                                                   ptp_proc_id
"
"                                              FROM prod_transfer_process
"
"                                             WHERE ptp_bu = p_bu
"
"                                               AND ptp_plnt = p_plnt
"
"                                               AND ptp_trans_no = p_trans_no
"
"                                            ORDER BY ptp_oprn_seq_no DESC;
"
"
"
"                                               CURSOR c1(c_store_id VARCHAR2)
"
"                                                 IS
"
"                                                SELECT
"
"                                                --store_acct_plnt ,
"
"                                                --store_gl_lvl1   ,
"
"                                                --store_gl_lvl2   ,
"
"                                                --store_gl_lvl3   ,
"
"                                                --store_gl_lvl4   ,
"
"                                                store_gl_acct ,
"
"                                                 store_id
"
"                                               FROM stores
"
"                                              WHERE store_bu = p_bu
"
"                                                AND store_id = c_store_id;
"
"
"
"                                                cr1        c1%ROWTYPE;
"
"                                                cr0        c0%ROWTYPE;
"
"                                                v_ac_db_amt    NUMBER(17,5);
"
"                                                v_rej_db_amt NUMBER(17,5);
"
"                                                v_cr_amt   NUMBER(17,5);
"
"                                                v_acct_lvl_prj    VARCHAR2(20);
"
"
"
"                        v_comp_pfx varchar2(10);
"
"                        v_vou_type  varchar2(10);
"
"                        v_sub_vou_type VARCHAR2(10);
"
"
"
"                                               BEGIN
"
"
"
"                                                   v_jrnl_trans_no := func_find_jrnl_trans_no(p_bu,p_user);
"
"
"
"                                                   v_acpt_dbt_store := p_rcpt_store_id;
"
"                                                   v_rej_dbt_store := p_rej_store_id;
"
"                                                   --v_crd_store := func_find_store_fr_type(p_bu,p_plnt,'P');
"
"                                                v_crd_store := func_find_store_fr_type(p_bu,p_plnt,p_plnt_loc_id,'Q');
"
"
"
"                                                SELECT pt_comp_pfx
"
"                                                  INTO v_comp_pfx
"
"                                                  FROM prod_transfer
"
"                                                 WHERE pt_bu = p_bu
"
"                                                   AND Pt_plnt = p_plnt
"
"                                                   AND pt_trans_no = p_trans_no;
"
"
"
"
"
"                                                    SELECT apsta_vou_type,apsta_sub_type
"
"                                                     INTO v_vou_type,v_sub_vou_type
"
"                                                     FROM APPL_PFX_SUB_TYPES_ASSO
"
"                                       WHERE  APSTA_PFX = v_comp_pfx
"
"            AND APSTA_BU  = p_bu;
"
"
"
"                                                   OPEN c0;
"
"                                                   FETCH c0 INTO cr0;
"
"                                                   CLOSE c0;
"
"
"
"                                                SELECT LISTAGG(ptp_oprn_id ||'-'||
"
"                                                       func_find_mfg_oper_desc(ptp_bu,ptp_plnt,ptp_oprn_id,1),',')
"
"                                                       WITHIN GROUP (ORDER BY ptp_oprn_id)
"
"                                                 INTO var_oprn_narr
"
"                                                FROM prod_transfeR_process
"
"                                                WHERE ptp_bu = p_bu
"
"                                                AND ptp_plnt = p_plnt
"
"                                                AND ptp_trans_no = p_trans_no;
"
"
"
"
"
"
"
"                                                   IF p_accept_qty > 0 THEN
"
"
"
"                                                    OPEN c1(v_acpt_dbt_store);
"
"                                                    FETCH c1 INTO cr1;
"
"                                                    IF  cr1.store_gl_acct IS NULL THEN
"
"
"
"                                                           RAISE_APPLICATION_ERROR(-20269,'ICM'|| 'Warehouse GL Account not found'|| v_acpt_dbt_store|| ' '||cr1.store_id);
"
"                                                    ELSE
"
"
"
"                                                         proc_find_cost_center (p_bu,
"
"                                                                                p_plnt,
"
"                                                                                NULL,
"
"                                                                                cr1.store_gl_acct,
"
"                                                                                NULL,
"
"                                                                                NULL,
"
"                                                                                NULL,
"
"                                                                                NULL,
"
"                                                                                v_dbt_ac_lvl1,
"
"                                                                                v_dbt_ac_lvl2,
"
"                                                                                v_dbt_ac_lvl3,
"
"                                                                                v_dbt_ac_lvl4,
"
"                                                                                v_dbt_ac_lvl5,
"
"                                                                                v_dbt_ac_lvl6,
"
"                                                                                v_acct_lvl_prj ,--p_acct_lvl_prj,
"
"                                                                                v_dbt_ac_plnt,
"
"                                                                                v_dbt_ac_cc_code,
"
"                                                                                v_dbt_loc_id
"
"                                                                                );
"
"
"
"
"
"
"
"                                                      -- v_dbt_ac_lvl1 := cr1.store_gl_lvl1;
"
"                                                     --  v_dbt_ac_lvl2 := cr1.store_gl_lvl2;
"
"                                                      -- v_dbt_ac_lvl3 := cr1.store_gl_lvl3;
"
"                                                       --v_dbt_ac_lvl4 := cr1.store_gl_lvl4;
"
"                                                       v_dbt_ac_acct := cr1.store_gl_acct;
"
"                                                       --v_dbt_ac_plnt := cr1.store_acct_plnt;
"
"
"
"                                                    END IF;
"
"
"
"                                                    CLOSE c1;
"
"                                                   END IF;
"
"
"
"                                                   IF p_rej_qty > 0 THEN
"
"
"
"                                                    OPEN c1(v_rej_dbt_store);
"
"                                                    FETCH c1 INTO cr1;
"
"                                                    IF cr1.store_gl_acct IS NULL THEN
"
"
"
"                                                           RAISE_APPLICATION_ERROR(-20269,'ICM'|| 'Warehouse GL Account not found'|| v_rej_dbt_store|| ' '||cr1.store_id);
"
"                                                    ELSE
"
"
"
"                                                         proc_find_cost_center (p_bu,
"
"                                                                                p_plnt,
"
"                                                                                NULL,
"
"                                                                                cr1.store_gl_acct,
"
"                                                                                NULL,
"
"                                                                                NULL,
"
"                                                                                NULL,
"
"                                                                                NULL,
"
"                                                                                v_dbt_rej_lvl1,
"
"                                                                                v_dbt_rej_lvl2,
"
"                                                                                v_dbt_rej_lvl3,
"
"                                                                                v_dbt_rej_lvl4,
"
"                                                                                v_dbt_rej_lvl5,
"
"                                                                                v_dbt_rej_lvl6,
"
"                                                                                v_acct_lvl_prj ,--p_acct_lvl_prj,
"
"                                                                                v_dbt_rej_plnt,
"
"                                                                                v_dbt_rej_cc_code,
"
"                                                                                v_dbt_loc_id
"
"                                                                                );
"
"
"
"
"
"                                                      -- v_dbt_rej_lvl1 := cr1.store_gl_lvl1;
"
"                                                      -- v_dbt_rej_lvl2 := cr1.store_gl_lvl2;
"
"                                                      -- v_dbt_rej_lvl3 := cr1.store_gl_lvl3;
"
"                                                      -- v_dbt_rej_lvl4 := cr1.store_gl_lvl4;
"
"                                                       v_dbt_rej_acct := cr1.store_gl_acct;
"
"                                                      -- v_dbt_rej_plnt := cr1.store_acct_plnt;
"
"
"
"                                                    END IF;
"
"                                                    CLOSE c1;
"
"                                                   END IF;
"
"
"
"
"
"                                                 OPEN c1(v_crd_store);
"
"                                                   FETCH c1 INTO cr1;
"
"                                                   IF cr1.store_gl_acct IS NULL THEN
"
"
"
"                                                       RAISE_APPLICATION_ERROR(-20269,'ICM'|| 'Warehouse GL Account not found'||v_crd_store|| ' '|| cr1.store_id);
"
"                                                ELSE
"
"
"
"                                                         proc_find_cost_center (p_bu,
"
"                                                                                p_plnt,
"
"                                                                                NULL,
"
"                                                                                cr1.store_gl_acct,
"
"                                                                                NULL,
"
"                                                                                NULL,
"
"                                                                                NULL,
"
"                                                                                NULL,
"
"                                                                                v_crd_lvl1,
"
"                                                                                v_crd_lvl2,
"
"                                                                                v_crd_lvl3,
"
"                                                                                v_crd_lvl4,
"
"                                                                                v_crd_lvl5,
"
"                                                                                v_crd_lvl6,
"
"                                                                                v_acct_lvl_prj ,--p_acct_lvl_prj,
"
"                                                                                v_crd_plnt,
"
"                                                                                v_crd_cc_code,
"
"                                                                                v_crd_loc_id
"
"                                                                                );
"
"
"
"                                                   --v_crd_lvl1 := cr1.store_gl_lvl1;
"
"                                                 --  v_crd_lvl2 := cr1.store_gl_lvl2;
"
"                                                  -- v_crd_lvl3 := cr1.store_gl_lvl3;
"
"                                                  -- v_crd_lvl4 := cr1.store_gl_lvl4;
"
"                                                   v_crd_acct := cr1.store_gl_acct;
"
"                                                  -- v_crd_plnt := cr1.store_acct_plnt;
"
"
"
"                                                   END IF;
"
"                                                   CLOSE c1;
"
"
"
"                                                   SELECT pt_unit_cost
"
"                                                     INTO v_unit_cost
"
"                                                      FROM PROD_TRANSFER
"
"                                                     WHERE PT_BU = P_BU
"
"                                                       AND PT_PLNT = P_PLNT
"
"                                                       AND PT_TRANS_NO = P_TRANS_NO;
"
"                                                   --v_unit_cost := func_find_sfg_unitcost(p_bu,p_prod_id,p_prod_rev,v_crd_store,p_prod_ord_no,p_sf_code,p_sys_ls_no);
"
"                                                   v_prod_desc1 := func_find_prod_qry_desc(p_bu,p_prod_id,p_prod_rev,p_lang);
"
"
"
"                                                   -- accept store debit
"
"
"
"                                                        IF p_accept_qty > 0 THEN
"
"
"
"
"
"                                                     SELECT NVL(MAX(aj_jrnl_trns_seq_no),0) + 1
"
"                                                       INTO v_jrnl_trans_seq_no
"
"                                                       FROM appl_journals
"
"                                                      WHERE aj_bu = p_bu
"
"                                                        AND aj_plnt = p_plnt
"
"                                                        AND aj_jrnl_trns_no = v_jrnl_trans_no;
"
"
"
"                                                     v_ac_db_amt := p_accept_qty * v_unit_cost;
"
"
"
"                                                     --RAISE_APPLICATION_ERROR(-20999,'HRM'||' ' ||v_unit_cost||' function ' ||func_find_sfg_unitcost(p_bu,p_prod_id,p_prod_rev,v_crd_store,p_prod_ord_no,p_sf_code,p_sys_ls_no));
"
"
"
"                                                     INSERT INTO appl_journals(
"
"                                                                aj_bu                     ,
"
"                                                                aj_plnt                   ,
"
"                                                                aj_jrnl_trns_no           ,
"
"                                                                aj_jrnl_trns_seq_no       ,
"
"                                                                aj_acctg_plnt             ,
"
"                                                                aj_gl_lvl1                ,
"
"                                                                aj_gl_lvl2                ,
"
"                                                                aj_gl_lvl3                ,
"
"                                                                aj_gl_lvl4                ,
"
"                                                                aj_gl_lvl5                ,
"
"                                                                aj_gl_lvl6                ,
"
"                                                                aj_cc_code                ,
"
"                                                                aj_gl_acct                ,
"
"                                                                aj_gl_acct_desc           ,
"
"                                                                aj_reference1             ,
"
"                                                                aj_reference2             ,
"
"                                                                aj_fc_db_amt              ,
"
"                                                                aj_fc_cr_amt              ,
"
"                                                                aj_bc_db_amt              ,
"
"                                                                aj_bc_cr_amt              ,
"
"                                                                aj_db_ex_rate             ,
"
"                                                                aj_cr_ex_rate             ,
"
"                                                                aj_jrnl_date              ,
"
"                                                                aj_jrnl_year              ,
"
"                                                                aj_jrnl_period            ,
"
"                                                                aj_store_id               ,
"
"                                                                aj_store_name             ,
"
"                                                                aj_cls_id                 ,
"
"                                                                aj_cls_desc               ,
"
"                                                                aj_sub_cls_id             ,
"
"                                                                aj_sub_cls_desc           ,
"
"                                                                aj_prod_id                ,
"
"                                                                aj_prod_rev               ,
"
"                                                                aj_prod_desc1             ,
"
"                                                                aj_tc_id                  ,
"
"                                                                aj_tc_desc                ,
"
"                                                                aj_suplr_id               ,
"
"                                                                aj_suplr_name             ,
"
"                                                                aj_cust_id                ,
"
"                                                                aj_cust_name              ,
"
"                                                                aj_area_id                ,
"
"                                                                aj_area_desc              ,
"
"                                                                aj_terr_id                ,
"
"                                                                aj_terr_desc              ,
"
"                                                                aj_bank_id                ,
"
"                                                                aj_bank_name              ,
"
"                                                                aj_fa_grp_id              ,
"
"                                                                aj_fa_grp_desc            ,
"
"                                                                aj_fa_id                  ,
"
"                                                                aj_fa_desc                ,
"
"                                                                aj_dept_id                ,
"
"                                                                aj_dept_desc              ,
"
"                                                                aj_proj_id                ,
"
"                                                                aj_proj_desc              ,
"
"                                                                aj_res_grp_id             ,
"
"                                                                aj_res_grp_desc           ,
"
"                                                                aj_res_id                 ,
"
"                                                                aj_res_desc               ,
"
"                                                                aj_emp_id                 ,
"
"                                                                aj_emp_name               ,
"
"                                                                aj_trans_qty              ,
"
"                                                                aj_unit_cost              ,
"
"                                                                aj_unit_price             ,
"
"                                                                aj_source_doc_mode        ,
"
"                                                                aj_appl                   ,
"
"                                                                aj_status                 ,
"
"                                                                aj_jrnl_no                ,
"
"                                                                aj_cre_by                 ,
"
"                                                                aj_cre_date               ,
"
"                                                                aj_upd_by                 ,
"
"                                                                aj_upd_date               ,
"
"                                                                aj_offset_doc_no          ,
"
"                                                                aj_vou_type               ,
"
"                                                                aj_vou_pfx                ,
"
"                                                                aj_vou_no                 ,
"
"                                                                aj_vou_line_no            ,
"
"                                                                aj_ref_no                 ,
"
"                                                                aj_ref_date,
"
"                                                                aj_gl_lvl_prj,
"
"                                                                aj_gl_plnt_loc_id,
"
"                                                                aj_src_plnt_loc_id,
"
"                                                                aj_sub_vou_type
"
"                                                                )
"
"                                                                VALUES(
"
"                                                                    p_bu                     ,
"
"                                                                    p_plnt             ,
"
"                                                                    v_jrnl_trans_no           ,
"
"                                                                    v_jrnl_trans_seq_no       ,
"
"                                                                    v_dbt_ac_plnt             ,
"
"                                                                    v_dbt_ac_lvl1                ,
"
"                                                                    v_dbt_ac_lvl2                ,
"
"                                                                    v_dbt_ac_lvl3                ,
"
"                                                                    v_dbt_ac_lvl4                ,
"
"                                                                    v_dbt_ac_lvl5                ,
"
"                                                                    v_dbt_ac_lvl6                ,
"
"                                                                    v_dbt_ac_cc_code                ,
"
"                                                                    v_dbt_ac_acct                ,
"
"                                                                    func_find_gl_acct_desc(p_bu,v_dbt_ac_acct,p_lang)           ,
"
"                                                                    'STOCK INCREASE AT RECEIPT STORE ('||p_trans_no ||'/' ||var_oprn_narr||' )'           ,
"
"                                                                    'STOCK INCREASE AT RECEIPT STORE'             ,
"
"                                                                    round((v_unit_cost * p_accept_qty),func_find_appl_rnddigit(p_bu)),
"
"                                                                    0              ,
"
"                                                                    round((v_unit_cost * p_accept_qty),func_find_appl_rnddigit(p_bu)),
"
"                                                                    0              ,
"
"                                                                    1             ,
"
"                                                                    1             ,
"
"                                                                    p_trans_date              ,
"
"                                                                    func_find_year(p_bu,p_trans_date)              ,
"
"                                                                    func_find_period(p_bu,p_trans_date)            ,
"
"                                                                    v_acpt_dbt_store               ,
"
"                                                                    func_find_store_desc(p_bu,v_acpt_dbt_store,p_lang)             ,
"
"                                                                    func_find_product_class(p_bu,p_plnt,p_prod_id,p_prod_rev)                 ,
"
"                                                                    func_find_class_desc(p_bu,func_find_product_class(p_bu,p_plnt,p_prod_id,p_prod_rev) ,p_lang)               ,
"
"                                                                    func_find_product_subclass(p_bu,p_plnt,p_prod_id,p_prod_rev)             ,
"
"                                                                    func_find_subclass_desc(p_bu,func_find_product_subclass(p_bu,p_plnt,p_prod_id,p_prod_rev) ,p_lang)           ,
"
"                                                                    p_prod_id                ,
"
"                                                                    p_prod_rev               ,
"
"                                                                    v_prod_desc1             ,
"
"                                                                    NULL                  ,
"
"                                                                    NULL                ,
"
"                                                                    NULL               ,
"
"                                                                    NULL             ,
"
"                                                                    NULL                ,
"
"                                                                    NULL              ,
"
"                                                                    NULL                ,
"
"                                                                    NULL              ,
"
"                                                                    NULL                ,
"
