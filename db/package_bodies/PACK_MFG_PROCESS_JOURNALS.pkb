"                                                                                                                    v_crd_store_id := cr4.pror_cons_store ; --func_find_store_fr_type(p_bu,p_plnt,'W');
"
"
"
"
"
"                                                                                                                                 OPEN c3(v_crd_store_id);
"
"                                                                            FETCH c3 INTO cr3;
"
"
"
"                                                                            IF (c3%NOTFOUND) OR (cr3.store_gl_acct IS NULL) THEN
"
"
"
"                                                                                RAISE_APPLICATION_ERROR(-20269,'ICM'|| 'Warehouse GL Account not found'||v_dbt_store_id||' ' || cr4.pror_cons_store);
"
"
"
"
"
"                                                                            ELSE
"
"
"
"                                                                                 proc_find_cost_center (p_bu,
"
"                                                                                            p_plnt,
"
"                                                                                            NULL,
"
"                                                                                            cr3.store_gl_acct,
"
"                                                                                            NULL,
"
"                                                                                            NULL,
"
"                                                                                            NULL,
"
"                                                                                            NULL,
