"
"
"
"
"
"
"
"
"
"                                                                                                                           FOR cr_scrap IN (SELECT pts_scrap_id,
"
"                                                                                                                                                                        pts_scrap_rev,
"
"                                                                                                                                                                        pts_store_id,
"
"                                                                                                                                                                        pts_oprn_id,
"
"                                                                                                                                                                        pts_proc_id,
"
"                                                                                                                                                                        pts_qty,
"
"                                                                                                                                                                        pts_unit_cost ,
"
"                                                                                                                                                                        pts_qty * pts_unit_cost pts_ext_rate
"
"                                                                                                                                                                   FROM prod_trans_scrap,prod_transfer
"
"                                                                                                                                                                  WHERE pt_bu = pts_bu
"
"                                                                                                                                                                    and pt_plnt = pts_plnt
"
"                                                                                                                                                                    and pt_trans_no  = pts_trans_no
"
"                                                                                                                                                                    and pt_pre_process_rej_qty >0 and
"
"                                                                                                                                                                    pts_bu = p_bu
"
"                                                                                                                                                                    AND pts_plnt = p_plnt
"
"                                                                                                                                                                    AND pts_trans_no = p_trans_no
"
"                                                                                                                                                                    AND pts_oprn_id = cr0.ptp_oprn_id
"
"                                                                                                                                                                        )
"
"                                                                                                                                                LOOP
"
"
"
"                                                                                                                                                v_dbt_store_id := cr_scrap.pts_store_id;
"
"
"
"                                                                                                                                                OPEN c3(v_dbt_store_id);
"
"                                                                                                        FETCH c3 INTO cr3;
"
"
"
"                                                                                                        IF (c3%NOTFOUND) OR (cr3.store_gl_acct IS NULL) THEN
"
"
"
"                                                                                                            RAISE_APPLICATION_ERROR(-20269,'ICM'|| 'Warehouse GL Account not found'||v_dbt_store_id||' ' || cr4.pror_rcp_store);
"
"
"
"
"
"                                                                                                        ELSE
"
"
"
"                                                                                                             proc_find_cost_center (p_bu,
"
"                                                                                                                        p_plnt,
"
"                                                                                                                        NULL,
"
"                                                                                                                        cr3.store_gl_acct,
"
"                                                                                                                        NULL,
"
"                                                                                                                        NULL,
"
"                                                                                                                        NULL,
"
"                                                                                                                        NULL,
"
"                                                                                                                        v_dbt_lvl1,
"
"                                                                                                                        v_dbt_lvl2,
"
"                                                                                                                        v_dbt_lvl3,
"
"                                                                                                                        v_dbt_lvl4,
"
"                                                                                                                        v_dbt_lvl5,
"
"                                                                                                                        v_dbt_lvl6,
"
"                                                                                                                        v_acct_lvl_prj ,--p_acct_lvl_prj,
"
"                                                                                                                        v_store_acct_plnt,
"
"                                                                                                                        v_dbt_cc_code,
"
"                                                                                                                        v_dbt_loc_id
"
"                                                                                                                        );
"
"
"
"                                                                                                        END IF;
"
"
"
"                                                                                                                 CLOSE c3;
"
"
