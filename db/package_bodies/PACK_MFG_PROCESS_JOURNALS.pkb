"                                                                            aj_cc_code                ,
"
"                                                                            aj_gl_acct                ,
"
"                                                                            aj_gl_acct_desc           ,
"
"                                                                            aj_reference1             ,
"
"                                                                            aj_reference2             ,
"
"                                                                            aj_fc_db_amt              ,
"
"                                                                            aj_fc_cr_amt              ,
"
"                                                                            aj_bc_db_amt              ,
"
"                                                                            aj_bc_cr_amt              ,
"
"                                                                            aj_db_ex_rate             ,
"
"                                                                            aj_cr_ex_rate             ,
"
"                                                                            aj_jrnl_date              ,
"
"                                                                            aj_jrnl_year              ,
"
"                                                                            aj_jrnl_period            ,
"
"                                                                            aj_store_id               ,
"
"                                                                            aj_store_name             ,
"
"                                                                            aj_cls_id                 ,
"
"                                                                            aj_cls_desc               ,
"
"                                                                            aj_sub_cls_id             ,
"
"                                                                            aj_sub_cls_desc           ,
"
"                                                                            aj_prod_id                ,
"
"                                                                            aj_prod_rev               ,
"
"                                                                            aj_prod_desc1             ,
"
"                                                                            aj_tc_id                  ,
"
"                                                                            aj_tc_desc                ,
"
"                                                                            aj_suplr_id               ,
"
"                                                                            aj_suplr_name             ,
"
"                                                                            aj_cust_id                ,
"
"                                                                            aj_cust_name              ,
"
"                                                                            aj_area_id                ,
"
"                                                                            aj_area_desc              ,
"
"                                                                            aj_terr_id                ,
"
"                                                                            aj_terr_desc              ,
"
"                                                                            aj_bank_id                ,
"
"                                                                            aj_bank_name              ,
"
"                                                                            aj_fa_grp_id              ,
"
"                                                                            aj_fa_grp_desc            ,
"
"                                                                            aj_fa_id                  ,
"
"                                                                            aj_fa_desc                ,
"
"                                                                            aj_dept_id                ,
"
"                                                                            aj_dept_desc              ,
"
"                                                                            aj_proj_id                ,
"
"                                                                            aj_proj_desc              ,
"
"                                                                            aj_res_grp_id             ,
"
"                                                                            aj_res_grp_desc           ,
"
"                                                                            aj_res_id                 ,
"
"                                                                            aj_res_desc               ,
"
"                                                                            aj_emp_id                 ,
"
"                                                                            aj_emp_name               ,
"
"                                                                            aj_trans_qty              ,
"
"                                                                            aj_unit_cost              ,
"
"                                                                            aj_unit_price             ,
"
"                                                                            aj_source_doc_mode        ,
"
"                                                                            aj_appl                   ,
"
"                                                                            aj_status                 ,
"
"                                                                            aj_jrnl_no                ,
"
"                                                                            aj_cre_by                 ,
"
"                                                                            aj_cre_date               ,
"
"                                                                            aj_upd_by                 ,
"
"                                                                            aj_upd_date               ,
"
"                                                                            aj_offset_doc_no          ,
"
"                                                                            aj_vou_type               ,
"
"                                                                            aj_vou_pfx                ,
"
"                                                                            aj_vou_no                 ,
"
"                                                                            aj_vou_line_no            ,
"
"                                                                            aj_ref_no                 ,
"
"                                                                            aj_ref_date,
"
"                                                                            aj_gl_lvl_prj,
"
"                                                                            aj_gl_plnt_loc_id,
"
"                                                                            aj_src_plnt_loc_id,
"
"                                                                            aj_sub_vou_type
"
"                                                                                )
"
"                                                                            VALUES(
"
"                                                                                p_bu                     ,
"
"                                                                                p_plnt                   ,
"
"                                                                                v_jrnl_trans_no           ,
"
"                                                                                v_jrnl_trans_seq_no       ,
"
"                                                                                v_crd_plnt             ,
"
"                                                                                v_crd_lvl1                ,
"
"                                                                                v_crd_lvl2               ,
"
"                                                                                v_crd_lvl3             ,
"
"                                                                                v_crd_lvl4              ,
"
"                                                                                v_crd_lvl5              ,
"
"                                                                                v_crd_lvl6              ,
"
"                                                                                v_crd_cc_code              ,
"
"                                                                                v_crd_acct               ,
"
"                                                                                func_find_gl_acct_desc(p_bu,v_crd_acct,p_lang)           ,
"
"                                                                                'STOCK DECREASE AT POST INSPECTION WAREHOUSE ('||p_trans_no||'/'||var_oprn_narr||' '||')'               ,
"
"                                                                                'STOCK DECREASE AT POST INSPECTION WAREHOUSE'             ,
"
"                                                                                0              ,
"
"                                                                                ROUND((v_unit_cost * p_rej_qty),func_find_appl_rnddigit(p_bu)),
"
"                                                                                0              ,
"
"                                                                                ROUND((v_unit_cost * p_rej_qty),func_find_appl_rnddigit(p_bu)),
"
"                                                                                1             ,
"
"                                                                                1             ,
"
"                                                                                p_trans_date              ,
"
"                                                                                func_find_year(p_bu,p_trans_date)              ,
"
"                                                                                func_find_period(p_bu,p_trans_date)            ,
"
"                                                                                v_crd_store               ,
"
"                                                                                func_find_store_desc(p_bu,v_crd_store,p_lang)             ,
"
"                                                                                func_find_product_class(p_bu,p_plnt,p_prod_id,p_prod_rev)                               ,
"
"                                                                                func_find_class_desc(p_bu,func_find_product_class(p_bu,p_plnt,p_prod_id,p_prod_rev) ,p_lang)               ,
"
"                                                                                func_find_product_subclass(p_bu,p_plnt,p_prod_id,p_prod_rev)                          ,
"
"                                                                                func_find_subclass_desc(p_bu,func_find_product_subclass(p_bu,p_plnt,p_prod_id,p_prod_rev) ,p_lang)           ,
"
"                                                                                p_prod_id                ,
"
"                                                                                p_prod_rev              ,
"
"                                                                                v_prod_desc1            ,
"
"                                                                                NULL                  ,
"
"                                                                                NULL                ,
"
"                                                                                NULL               ,
"
"                                                                                NULL             ,
"
"                                                                                NULL                ,
"
"                                                                                NULL              ,
"
"                                                                                NULL                ,
"
"                                                                                NULL              ,
"
"                                                                                NULL                ,
"
"                                                                                NULL              ,
"
"                                                                                NULL                ,
"
"                                                                                NULL              ,
"
"                                                                                NULL              ,
"
"                                                                                NULL            ,
"
"                                                                                NULL                  ,
"
"                                                                                NULL                ,
"
"                                                                                cr0.ptp_proc_id                ,
"
"                                                                                func_find_process_desc(p_bu,p_plnt,cr0.ptp_proc_id,p_lang)              ,
"
"                                                                                NULL                ,
"
"                                                                                NULL              ,
"
"                                                                                NULL             ,
"
"                                                                                NULL,
"
"                                                                                NULL                 ,
"
"                                                                                NULL               ,
"
"                                                                                NULL                 ,
"
"                                                                                NULL               ,
"
"                                                                                p_rej_qty              ,
"
"                                                                                v_unit_cost              ,
"
"                                                                                v_unit_cost             ,
"
"                                                                                NULL        ,
"
"                                                                                'SFM'                   ,
"
"                                                                                'N'                 ,
"
"                                                                                NULL                ,
"
"                                                                                p_user                 ,
"
"                                                                                SYSDATE               ,
"
"                                                                                NULL                 ,
"
"                                                                                NULL               ,
"
"                                                                                NULL          ,
"
"                                                                                v_vou_type           ,
"
"                                                                                NULL                ,
"
"                                                                                p_trans_no                 ,
"
"                                                                                1         ,
"
"                                                                                NULL                 ,
"
"                                                                                NULL,
"
"                                                                                v_acct_lvl_prj,
"
"                                                                                v_crd_loc_id,
"
"                                                                                v_crd_loc_id,
"
"                                                                                v_sub_vou_type
"
"                                                                            );
"
"
"
"
"
"
"
"
"
"
"
"                                                                    END IF;
"
"
"
"
"
"                                               END proc_cre_jrnl_nqc_ocw_to_rcpt;
"
"
"
"                            PROCEDURE proc_cre_jrnl_bq(
"
"                                              p_bu        VARCHAR2,
"
"                                              p_plnt        VARCHAR2,
"
"                                              p_comp_doc_no    VARCHAR2,
"
"                                              p_trans_no    VARCHAR2,
"
"                                              p_trans_date    DATE,
"
"                                              p_prod_ord_no    VARCHAR2,
"
"                                              p_bom_no    VARCHAR2,
"
"                                              p_prod_id    VARCHAR2,
"
"                                              p_prod_rev    NUMBER,
"
"                                              p_proc_qty    NUMBER,
"
"                                              p_unit_cost    NUMBER,
"
"                                              p_sf_code    VARCHAR2,
"
"                                              p_sys_ls_no    NUMBER,
"
"                                              p_lang        NUMBER,
"
"                                              p_user        VARCHAR2
"
"                                          )
"
"                                          IS
"
"
"
"
"
"                                         v_dbt_lvl1         VARCHAR2(20);
"
"                                         v_dbt_lvl2        VARCHAR2(20);
"
"                                         v_dbt_lvl3        VARCHAR2(20);
"
"                                         v_dbt_lvl4        VARCHAR2(20);
"
"                                         v_dbt_lvl5        VARCHAR2(20);
"
"                                         v_dbt_lvl6        VARCHAR2(20);
"
"                                         v_dbt_cc_code        VARCHAR2(100);
"
"                                         v_dbt_acct        VARCHAR2(20);
"
"                                         v_dbt_plnt        VARCHAR2(10);
"
"
"
"
"
"                                         v_crd_lvl1        VARCHAR2(20);
"
"                                         v_crd_lvl2        VARCHAR2(20);
"
"                                         v_crd_lvl3        VARCHAR2(20);
"
"                                         v_crd_lvl4        VARCHAR2(20);
"
"                                         v_crd_lvl5        VARCHAR2(20);
"
"                                         v_crd_lvl6        VARCHAR2(20);
"
"                                         v_crd_cc_code        VARCHAR2(20);
"
"                                         v_crd_acct        VARCHAR2(20);
"
"                                         v_crd_plnt        VARCHAR2(10);
"
"
"
"                                         v_jrnl_trans_no    VARCHAR2(15);
"
"                                         v_jrnl_trans_seq_no    NUMBER;
"
"                                         v_unit_cost        NUMBER(17,5);
"
"                                         v_prod_desc1        VARCHAR2(150);
"
"                                         var_oprn_narr        VARCHAR2(4000);
"
"                                         v_dbt_store_id        VARCHAR2(10);
"
"                                         v_crd_store_id        VARCHAR2(10);
"
"                                         v_crd_loc_id        VARCHAR2(10);
"
"                                         v_dbt_loc_id        VARCHAR2(10);
"
"                                         v_plnt_loc_id        VARCHAR2(10);
"
"
"
"                                        CURSOR c0
"
"                                          IS
"
"                                        SELECT ptp_oprn_seq_no,
"
"                                               ptp_oprn_id    ,
"
"                                               ptp_proc_id
"
"                                          FROM prod_transfer_process
"
"                                         WHERE ptp_bu = p_bu
"
"                                           AND ptp_plnt = p_plnt
"
"                                           AND ptp_trans_no = p_trans_no
"
"                                        ORDER BY ptp_oprn_seq_no DESC;
"
"
"
"                                         CURSOR c1(c_store_id VARCHAR2)
"
"                                           IS
"
"                                          SELECT
"
"                                        --    store_acct_plnt ,
"
"                                        --    store_gl_lvl1   ,
"
"                                        --    store_gl_lvl2   ,
"
"                                        --    store_gl_lvl3   ,
"
"                                        --    store_gl_lvl4   ,
"
"                                            store_gl_acct ,
"
"                                            store_id
"
"                                           FROM stores
"
"                                          WHERE store_bu = p_bu
"
"                                            AND store_id = c_store_id;
"
"
"
"                                            cr1        c1%ROWTYPE;
"
"                                            cr0        c0%ROWTYPE;
"
"                                            v_ac_db_amt     NUMBER(17,5);
"
"                                            v_rej_db_amt NUMBER(17,5);
"
"                                            v_cr_amt     NUMBER(17,5);
"
"
"
"                                            v_acct_lvl_prj    VARCHAR2(20);
"
"
"
"                        V_COMP_PFX VARCHAR2(10);
"
"                        v_vou_type varchar2(10);
"
"                        v_sub_vou_type VARCHAR2(10);
"
"
"
"
"
"                                  BEGIN
"
"
"
"                        select PT_COMP_PFX
"
"                          INTO V_COMP_PFX
"
"                          from PROD_TRANSFER
"
"                         WHERE PT_BU  = P_BU
"
"                           AND PT_PLNT = P_PLNT
"
"                           AND PT_TRANS_NO = P_TRANS_NO;
"
"
"
"
"
"                              SELECT apsta_vou_type,apsta_sub_type
"
"                                                  INTO v_vou_type,v_sub_vou_type
"
"                                                  FROM APPL_PFX_SUB_TYPES_ASSO
"
"                                    WHERE  APSTA_PFX = v_comp_pfx
"
"                                    AND APSTA_BU  = p_bu;
"
"
"
"                                        OPEN c0;
"
"                                        FETCH c0 INTO cr0;
"
"                                        CLOSE c0;
"
"
"
"                                            SELECT LISTAGG(ptp_oprn_id ||'-'||
"
"                                                   func_find_mfg_oper_desc(ptp_bu,ptp_plnt,ptp_oprn_id,1),',')
"
"                                                   WITHIN GROUP (ORDER BY ptp_oprn_id)
"
"                                             INTO var_oprn_narr
"
"                                            FROM prod_transfeR_process
"
"                                            WHERE ptp_bu = p_bu
"
"                                            AND ptp_plnt = p_plnt
"
"                                            AND ptp_trans_no = p_trans_no;
"
"
"
"                                      v_dbt_store_id := func_find_store_fr_type(p_bu,p_plnt,NULL,'Q');
"
"                                      v_crd_store_id := func_find_store_fr_type(p_bu,p_plnt,NULL,'O');
"
"
"
"                                      OPEN c1(v_dbt_store_id);
"
"                                      FETCH c1 INTO cr1;
"
"                                      IF  cr1.store_gl_acct IS NULL THEN
"
"                                           RAISE_APPLICATION_ERROR(-20269,'ICM'|| 'Warehouse GL Account not found'|| v_dbt_store_id || ' '||cr1.store_id);
"
"                                       ELSE
"
"
"
"                                         proc_find_cost_center (p_bu,
"
"                                                                p_plnt,
"
"                                                                NULL,
"
"                                                                cr1.store_gl_acct,
"
"                                                                NULL,
"
"                                                                NULL,
"
"                                                                NULL,
"
"                                                                NULL,
"
"                                                                v_dbt_lvl1,
"
"                                                                v_dbt_lvl2,
"
"                                                                v_dbt_lvl3,
"
"                                                                v_dbt_lvl4,
"
"                                                                v_dbt_lvl5,
"
"                                                                v_dbt_lvl6,
"
"                                                                v_acct_lvl_prj ,--p_acct_lvl_prj,
"
"                                                                v_dbt_plnt,
"
"                                                                v_crd_cc_code,
"
"                                                                v_crd_loc_id
"
"                                                                );
"
"
"
"                                        --   v_dbt_lvl1 := cr1.store_gl_lvl1;
"
"                                        --   v_dbt_lvl2 := cr1.store_gl_lvl2;
"
"                                       --    v_dbt_lvl3 := cr1.store_gl_lvl3;
"
"                                        --   v_dbt_lvl4 := cr1.store_gl_lvl4;
"
"                                           v_dbt_acct := cr1.store_gl_acct;
"
"                                        --   v_dbt_plnt := cr1.store_acct_plnt;
"
"                                       END IF;
"
"                                       CLOSE c1;
"
"
"
"                                       OPEN c1(v_crd_store_id);
"
"                                    FETCH c1 INTO cr1;
"
"                                    IF  cr1.store_gl_acct IS NULL THEN
"
"                                        RAISE_APPLICATION_ERROR(-20269,'ICM'|| 'Warehouse GL Account not found'|| cr1.store_id);
"
"                                     ELSE
"
"
"
"                                         proc_find_cost_center (p_bu,
"
"                                                                p_plnt,
"
"                                                                NULL,
"
"                                                                cr1.store_gl_acct,
"
"                                                                NULL,
"
"                                                                NULL,
"
"                                                                NULL,
"
"                                                                NULL,
"
"                                                                v_crd_lvl1,
"
"                                                                v_crd_lvl2,
"
"                                                                v_crd_lvl3,
"
"                                                                v_crd_lvl4,
"
"                                                                v_crd_lvl5,
"
"                                                                v_crd_lvl6,
"
"                                                                v_acct_lvl_prj ,--p_acct_lvl_prj,
"
"                                                                v_crd_plnt,
"
"                                                                v_crd_cc_code,
"
"                                                                v_crd_loc_id
"
"                                                                );
"
"
"
"                                        -- v_crd_lvl1 := cr1.store_gl_lvl1;
"
"                                       --  v_crd_lvl2 := cr1.store_gl_lvl2;
"
"                                        -- v_crd_lvl3 := cr1.store_gl_lvl3;
"
"                                       --  v_crd_lvl4 := cr1.store_gl_lvl4;
"
"                                         v_crd_acct := cr1.store_gl_acct;
"
"                                        -- v_crd_plnt := cr1.store_acct_plnt;
"
"                                     END IF;
"
"                                       CLOSE c1;
"
"
"
"
"
"                                       v_unit_cost := func_find_sfg_unitcost(p_bu,p_prod_id,p_prod_rev,v_crd_store_id,p_prod_ord_no,p_sf_code,p_sys_ls_no);
"
"                                       v_prod_desc1 := func_find_prod_qry_desc(p_bu,p_prod_id,p_prod_rev,p_lang);
"
"
"
"                                       v_jrnl_trans_no := func_find_jrnl_trans_no(p_bu,p_user);
"
"
"
"                                     SELECT NVL(MAX(aj_jrnl_trns_seq_no),0) + 1
"
"                                      INTO v_jrnl_trans_seq_no
"
"                                      FROM appl_journals
"
"                                     WHERE aj_bu = p_bu
"
"                                       AND aj_plnt = p_plnt
"
"                                       AND aj_jrnl_trns_no = v_jrnl_trans_no;
"
"
"
"
"
"                                       INSERT INTO appl_journals(
"
"                                                aj_bu                     ,
"
"                                                aj_plnt                   ,
"
"                                                aj_jrnl_trns_no           ,
"
"                                                aj_jrnl_trns_seq_no       ,
"
"                                                aj_acctg_plnt             ,
"
"                                                aj_gl_lvl1                ,
"
"                                                aj_gl_lvl2                ,
"
"                                                aj_gl_lvl3                ,
"
"                                                aj_gl_lvl4                ,
"
"                                                aj_gl_lvl5                ,
"
"                                                aj_gl_lvl6                ,
"
"                                                aj_cc_code                ,
"
"                                                aj_gl_acct                ,
"
"                                                aj_gl_acct_desc           ,
"
"                                                aj_reference1             ,
"
"                                                aj_reference2             ,
"
"                                                aj_fc_db_amt              ,
"
"                                                aj_fc_cr_amt              ,
"
"                                                aj_bc_db_amt              ,
"
"                                                aj_bc_cr_amt              ,
"
"                                                aj_db_ex_rate             ,
"
"                                                aj_cr_ex_rate             ,
"
"                                                aj_jrnl_date              ,
"
"                                                aj_jrnl_year              ,
"
"                                                aj_jrnl_period            ,
"
"                                                aj_store_id               ,
"
"                                                aj_store_name             ,
"
"                                                aj_cls_id                 ,
"
"                                                aj_cls_desc               ,
"
"                                                aj_sub_cls_id             ,
"
"                                                aj_sub_cls_desc           ,
"
"                                                aj_prod_id                ,
"
"                                                aj_prod_rev               ,
"
"                                                aj_prod_desc1             ,
"
"                                                aj_tc_id                  ,
"
"                                                aj_tc_desc                ,
"
"                                                aj_suplr_id               ,
"
"                                                aj_suplr_name             ,
"
"                                                aj_cust_id                ,
"
"                                                aj_cust_name              ,
"
"                                                aj_area_id                ,
"
"                                                aj_area_desc              ,
"
"                                                aj_terr_id                ,
"
"                                                aj_terr_desc              ,
"
"                                                aj_bank_id                ,
"
"                                                aj_bank_name              ,
"
"                                                aj_fa_grp_id              ,
"
"                                                aj_fa_grp_desc            ,
"
"                                                aj_fa_id                  ,
"
"                                                aj_fa_desc                ,
"
"                                                aj_dept_id                ,
"
"                                                aj_dept_desc              ,
"
"                                                aj_proj_id                ,
"
"                                                aj_proj_desc              ,
"
"                                                aj_res_grp_id             ,
"
"                                                aj_res_grp_desc           ,
"
"                                                aj_res_id                 ,
"
"                                                aj_res_desc               ,
"
"                                                aj_emp_id                 ,
"
"                                                aj_emp_name               ,
"
"                                                aj_trans_qty              ,
"
"                                                aj_unit_cost              ,
"
"                                                aj_unit_price             ,
"
"                                                aj_source_doc_mode        ,
"
"                                                aj_appl                   ,
"
"                                                aj_status                 ,
"
"                                                aj_jrnl_no                ,
"
"                                                aj_cre_by                 ,
"
"                                                aj_cre_date               ,
"
"                                                aj_upd_by                 ,
"
"                                                aj_upd_date               ,
"
"                                                aj_offset_doc_no          ,
"
"                                                aj_vou_type               ,
"
"                                                aj_vou_pfx                ,
"
"                                                aj_vou_no                 ,
"
"                                                aj_vou_line_no            ,
"
"                                                aj_ref_no                 ,
"
"                                                aj_ref_date,
"
"                                                aj_gl_lvl_prj,
"
"                                                aj_gl_plnt_loc_id,
"
"                                                aj_src_plnt_loc_id,
"
"                                                aj_sub_vou_type
"
"                                                 )
"
"                                            VALUES(
"
"                                                p_bu                     ,
"
"                                                p_plnt             ,
"
"                                                v_jrnl_trans_no           ,
"
"                                                v_jrnl_trans_seq_no       ,
"
"                                                v_dbt_plnt             ,
"
"                                                v_dbt_lvl1                ,
"
"                                                v_dbt_lvl2                ,
"
"                                                v_dbt_lvl3                ,
"
"                                                v_dbt_lvl4                ,
"
"                                                v_dbt_lvl5                ,
"
"                                                v_dbt_lvl6                ,
"
"                                                v_dbt_cc_code                ,
"
"                                                v_dbt_acct                ,
"
"                                                func_find_gl_acct_desc(p_bu,v_dbt_acct,p_lang)           ,
"
"                                                'STOCK INCREASE AT INSPECTION STORE ('||p_trans_no ||'/' ||var_oprn_narr||' )'           ,
"
"                                                'STOCK INCREASE AT INSPECTION STORE'             ,
"
"                                                round((v_unit_cost * p_proc_qty),func_find_appl_rnddigit(p_bu)),
"
"                                                0              ,
"
"                                                round((v_unit_cost * p_proc_qty),func_find_appl_rnddigit(p_bu)),
"
"                                                0              ,
"
"                                                1             ,
"
"                                                1             ,
"
"                                                p_trans_date              ,
"
"                                                func_find_year(p_bu,p_trans_date)              ,
"
"                                                func_find_period(p_bu,p_trans_date)            ,
"
"                                                v_dbt_store_id               ,
"
"                                                func_find_store_desc(p_bu,v_dbt_store_id,p_lang)             ,
"
"                                                func_find_product_class(p_bu,p_plnt,p_prod_id,p_prod_rev)                 ,
"
"                                                func_find_class_desc(p_bu,func_find_product_class(p_bu,p_plnt,p_prod_id,p_prod_rev) ,p_lang)               ,
"
"                                                func_find_product_subclass(p_bu,p_plnt,p_prod_id,p_prod_rev)             ,
"
"                                                func_find_subclass_desc(p_bu,func_find_product_subclass(p_bu,p_plnt,p_prod_id,p_prod_rev) ,p_lang)           ,
"
"                                                p_prod_id                ,
"
"                                                p_prod_rev               ,
"
"                                                v_prod_desc1             ,
"
"                                                NULL                  ,
"
"                                                NULL                ,
"
"                                                NULL               ,
"
"                                                NULL             ,
"
"                                                NULL                ,
"
"                                                NULL              ,
"
"                                                NULL                ,
"
"                                                NULL              ,
"
"                                                NULL                ,
"
"                                                NULL              ,
"
"                                                NULL                ,
"
"                                                NULL              ,
"
"                                                NULL              ,
"
"                                                NULL            ,
"
"                                                NULL                  ,
"
"                                                NULL                ,
"
"                                                cr0.ptp_proc_id                ,
"
"                                                func_find_process_desc(p_bu,p_plnt,cr0.ptp_proc_id,p_lang)              ,
"
"                                                NULL                ,
"
"                                                NULL              ,
"
"                                                NULL             ,
"
"                                                NULL           ,
"
"                                                NULL                 ,
"
"                                                NULL               ,
"
"                                                NULL                 ,
"
"                                                NULL               ,
"
"                                                p_proc_qty              ,
"
"                                                p_unit_cost              ,
"
"                                                p_unit_cost             ,
"
"                                                NULL        ,
"
"                                                'SFM'                   ,
"
"                                                'N'                 ,
"
"                                                NULL                ,
"
"                                                p_user                 ,
"
"                                                SYSDATE               ,
"
"                                                NULL                 ,
"
"                                                NULL               ,
"
"                                                NULL          ,
"
"                                                V_VOU_TYPE             ,
"
"                                                NULL                ,
"
"                                                p_trans_no                 ,
"
"                                                1            ,
"
"                                                NULL                 ,
"
"                                                NULL,
"
"                                                v_acct_lvl_prj,
"
"                                                v_crd_loc_id,
"
"                                                v_crd_loc_id,
"
"                                                V_SUB_VOU_TYPE
"
"                                                );
"
"
"
"
"
"
"
"
"
"                                            SELECT NVL(MAX(aj_jrnl_trns_seq_no),0) + 1
"
"                                              INTO v_jrnl_trans_seq_no
"
"                                              FROM appl_journals
"
"                                             WHERE aj_bu = p_bu
"
"                                               AND aj_plnt = p_plnt
"
"                                               AND aj_jrnl_trns_no = v_jrnl_trans_no;
"
"
"
"
"
"
"
"
"
"
"
"                                            INSERT INTO appl_journals(
"
"                                                        aj_bu                     ,
"
"                                                        aj_plnt                   ,
"
"                                                        aj_jrnl_trns_no           ,
"
"                                                        aj_jrnl_trns_seq_no       ,
"
