"
"
"
"
"                                        FOR cr1 IN c1(cr0.ptp_proc_id,cr0.ptp_oprn_id,v_res_cost_inc)
"
"                                        LOOP
"
"
"
"
"
"                                            IF (func_find_resgrp_charge_type(p_bu,cr1.ptsru_plnt,cr1.ptsru_res_grp) = 'S' AND cr1.mfgrg_current_acct IS NULL)
"
"                                               OR (func_find_resgrp_charge_type(p_bu,cr1.ptsru_plnt,cr1.ptsru_res_grp) = 'A' AND cr1.mfgrg_current_acct IS NULL ) THEN
"
"                                                   RAISE_APPLICATION_ERROR(-20612,'SFM' ||'Resource group gl account not defined' ||cr1.ptsru_res_grp);-- ||'/'||func_find_resources_desc(p_bu,cr1.ptsru_plnt,cr1.ptsru_res_grp,1));
"
"                                            ELSIF (func_find_resgrp_charge_type(p_bu,cr1.ptsru_plnt,cr1.ptsru_res_grp) = 'S' AND
"
"                                                (cr1.mfgrg_ac_lvl1 IS NULL
"
"                                                OR cr1.mfgrg_ac_lvl2 IS NULL
"
"                                                OR cr1.mfgrg_ac_lvl3 IS NULL
"
"                                                OR cr1.mfgrg_ac_lvl4 IS NULL
"
"                                                OR cr1.mfgrg_acct_plnt IS NULL
"
"                                                OR cr1.mfgrg_ac_lvl_prj IS NULL))
"
"                                                OR (func_find_resgrp_charge_type(p_bu,cr1.ptsru_plnt,cr1.ptsru_res_grp) = 'A' AND
"
"                                                (cr1.mfgrg_ac_lvl1 IS NULL
"
"                                                OR cr1.mfgrg_ac_lvl2 IS NULL
"
"                                                OR cr1.mfgrg_ac_lvl3 IS NULL
"
"                                                OR cr1.mfgrg_ac_lvl4 IS NULL
"
"                                                OR cr1.mfgrg_acct_plnt IS NULL
"
"                                                OR cr1.mfgrg_ac_lvl_prj IS NULL)) THEN
"
"                                                    Raise_Application_Error(-20183,'APM '||p_bu || '-' || p_plnt || '-'
"
"                                                    || cr1.mfgrg_current_acct||'-'||'Resource group cost center not defined'||'/'||cr1.ptsru_res_grp );
"
"                                                END IF;
"
