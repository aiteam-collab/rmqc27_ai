"
"                                                                func_find_process_desc(p_bu,p_plnt,cr0.ptp_proc_id,p_lang)              ,
"
"                                                                NULL                ,
"
"                                                                NULL              ,
"
"                                                                NULL             ,
"
"                                                                NULL,
"
"                                                                NULL                 ,
