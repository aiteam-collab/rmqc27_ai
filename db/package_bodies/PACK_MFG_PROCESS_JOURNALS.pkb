"                                                                                            v_crd_lvl2,
"
"                                                                                            v_crd_lvl3,
"
"                                                                                            v_crd_lvl4,
"
"                                                                                            v_crd_lvl5,
"
"                                                                                            v_crd_lvl6,
"
"                                                                                            v_acct_lvl_prj ,--p_acct_lvl_prj,
"
"                                                                                            v_store_acct_plnt,
"
"                                                                                            v_crd_cc_code,
"
"                                                                                            v_crd_loc_id
"
"                                                                                            );
"
"
"
"                                                                            END IF;
"
"
"
"                                                                                                                    CLOSE c3;
"
"
