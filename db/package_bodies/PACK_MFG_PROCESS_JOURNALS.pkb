"
"                                                                               FOR c1_oh1 IN c1_oh(cr0.ptp_proc_id,cr0.ptp_oprn_id,v_res_cost_inc)
"
"                                                                                LOOP
"
"                                                                                    IF (c1_oh1.moa_acct IS NULL OR c1_oh1.moa_lvl1 IS NULL OR
"
"                                                                                        c1_oh1.moa_lvl2 IS NULL OR c1_oh1.moa_lvl3 IS NULL OR
"
"                                                                                        c1_oh1.moa_ac_plnt IS NULL OR c1_oh1.mfgr_prj_lvl IS NULL) THEN
"
"                                                                                           RAISE_APPLICATION_ERROR(-20008,'SFM' ||'Resource group gl account not defined');
"
"                                                                                    END IF;
"
"
"
"                                                                                        v_oh_lvl1 :=  c1_oh1.moa_lvl1 ;
"
"                                                                                        v_oh_lvl2 :=  c1_oh1.moa_lvl2 ;
"
"                                                                                        v_oh_lvl3 := c1_oh1.moa_lvl3 ;
"
"                                                                                        v_oh_lvl4 := c1_oh1.moa_lvl4 ;
"
"                                                                                        v_oh_lvl5 := c1_oh1.moa_lvl5;
"
"                                                                                        v_oh_lvl6 := c1_oh1.moa_lvl6;
"
"                                                                                        v_oh_lvl_prj :=    c1_oh1.mfgr_prj_lvl;
"
"                                                                                        v_oh_lvl_plnt  := c1_oh1.moa_ac_plnt;
"
"                                                                                        v_oh_cc_code := c1_oh1.moa_cc_code;
"
"
"
"                                                                                        IF v_oh_lvl1 IS NULL OR v_oh_lvl2 IS NULL OR v_oh_lvl3 IS NULL OR v_oh_lvl4 IS NULL OR v_oh_lvl_prj IS NULL OR v_oh_lvl_plnt IS NULL THEN
"
"                                                                                              Raise_Application_Error(-20183,'APM '||p_bu || '-' || p_plnt || '-' || c1_oh1.moa_acct||'-'||cr0.ptp_proc_id);
"
"                                                                                        END IF;
