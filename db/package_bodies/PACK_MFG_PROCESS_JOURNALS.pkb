"
"
"                                            END proc_cre_jrnl_aq;
"
"
"
"
"
"
"
"
"
"
"
"
"
"            PROCEDURE proc_cre_jrnl_aq_partial(
"
"                            p_bu        VARCHAR2,
"
"                            p_plnt        VARCHAR2,
"
"                            p_comp_doc_no    VARCHAR2,
"
"                            p_trans_no    VARCHAR2,
"
"                            p_trans_date    DATE,
"
"                            p_prod_ord_no    VARCHAR2,
"
"                            p_qc_pfx    VARCHAR2,
"
"                            p_qc_no        VARCHAR2,
"
"                            p_rcpt_store    VARCHAR2,
"
"                            p_prod_id    VARCHAR2,
"
"                            p_prod_rev    NUMBER,
"
"                            p_accept_qty    NUMBER,
"
"                            p_unit_cost    NUMBER,
"
"                            p_sf_code    VARCHAR2,
"
"                            p_sys_ls_no    NUMBER,
"
"                            p_lang        NUMBER,
"
"                            p_user        VARCHAR2
"
"                        )
"
"                        IS
"
"
"
"                    v_dbt_store_id        VARCHAR2(10);
"
"                    v_crd_store_id        VARCHAR2(10);
"
"                    v_unit_cost        NUMBER(17,5);
"
"                    v_prod_desc1        VARCHAR2(150);
"
"
"
"                    v_dbt_lvl1        VARCHAR2(20);
"
"                    v_dbt_lvl2        VARCHAR2(20);
"
"                    v_dbt_lvl3        VARCHAR2(20);
"
"                    v_dbt_lvl4        VARCHAR2(20);
"
"                    v_dbt_lvl5        VARCHAR2(20);
"
"                    v_dbt_lvl6        VARCHAR2(20);
"
"                    v_dbt_cc_code        VARCHAR2(100);
"
"                    v_dbt_acct        VARCHAR2(20);
"
"                    v_dbt_plnt        VARCHAR2(10);
"
"
"
"                    v_crd_lvl1        VARCHAR2(20);
"
"                    v_crd_lvl2        VARCHAR2(20);
"
"                    v_crd_lvl3        VARCHAR2(20);
"
"                    v_crd_lvl4        VARCHAR2(20);
"
"                    v_crd_lvl5        VARCHAR2(20);
"
"                    v_crd_lvl6        VARCHAR2(20);
"
"                    v_crd_cc_code        VARCHAR2(100);
"
"                    v_crd_acct        VARCHAR2(20);
"
"                    v_crd_plnt        VARCHAR2(10);
"
"                    v_crd_loc_id        VARCHAR2(10);
"
"                    v_dbt_loc_id        VARCHAR2(10);
"
"                    v_plnt_loc_id        VARCHAR2(10);
"
"
"
"                    var_oprn_narr        VARCHAR2(4000);
"
"
"
"                    CURSOR c0
"
"                      IS
"
"                    SELECT ptp_oprn_seq_no,
"
"                           ptp_oprn_id    ,
"
"                           ptp_proc_id
"
"                      FROM prod_transfer_process
"
"                     WHERE ptp_bu = p_bu
"
"                       AND ptp_plnt = p_plnt
"
"                       AND ptp_trans_no = p_trans_no
"
"                     ORDER BY ptp_oprn_seq_no DESC;
"
"
"
"                    CURSOR c1(c_store_id VARCHAR2)
"
"                      IS
"
"                    SELECT store_id,
"
"                           --store_gl_lvl1,
"
"                          -- store_gl_lvl2,
"
"                         --  store_gl_lvl3,
"
"                         --  store_gl_lvl4,
"
"                           store_gl_acct
"
"                          -- store_acct_plnt
"
"                      FROM stores
"
"                     WHERE store_bu = p_bu
"
"                       AND store_id = c_store_id;
"
"
"
"                     cursor c4(c_prod_id VARCHAR2, c_prod_rev NUMBER, c_crd_store_id VARCHAR2, c_prod_ord_no VARCHAR2, c_sf_code VARCHAR2)
"
"                        IS
"
"                                   select STSFS_UNIT_COST
"
"                      from STORE_SF_STOCKS
"
"                     where STSFS_BU = P_BU
"
"                       and STSFS_PROD_ID = c_prod_id
"
"                       and STSFS_PROD_REV = c_prod_rev
"
"                       and STSFS_STORE_ID = c_CRD_STORE_ID
"
"                       and STSFS_ORD_NO = c_PROD_ORD_NO
"
"                       AND stsfs_sf_code = c_sf_code;
"
"
"
"                      cr1        c1%ROWTYPE;
"
"                      cr0        c0%ROWTYPE;
"
"                      cr4        c4%ROWTYPE;
"
"                      v_sf_qty    NUMBER(12,3);
"
"
"
"                      v_jrnl_trans_no    VARCHAR2(15);
"
"                      v_jrnl_trans_seq_no     NUMBER;
"
"
"
"v_acct_lvl_prj    VARCHAR2(20);
"
"V_COMP_PFX VARCHAR2(10);
"
"v_vou_type VARCHAR2(10);
"
"v_sub_vou_type VARCHAR2(10);
"
"
"
"                BEGIN
"
"
"
"                    OPEN c0;
"
"                    FETCH c0 INTO cr0;
"
"                    CLOSE c0;
"
"
"
"                    select pt_comp_pfx
"
"                      into v_comp_pfx
"
"                      from prod_transfer
"
"                     where pt_bu = p_bu
"
"                       and pt_plnt = p_plnt
"
"                       and pt_trans_no = p_trans_no;
"
"
"
"                             SELECT apsta_vou_type,apsta_sub_type
"
"                                         INTO v_vou_type,v_sub_vou_type
"
"                                         FROM APPL_PFX_SUB_TYPES_ASSO
"
"                           WHERE  APSTA_PFX = v_comp_pfx
"
"            AND APSTA_BU  = p_bu;
"
"
"
"                    SELECT LISTAGG(ptp_oprn_id ||'-'||
"
"                    func_find_mfg_oper_desc(ptp_bu,ptp_plnt,ptp_oprn_id,1),',')
"
"                    WITHIN GROUP (ORDER BY ptp_oprn_id)
"
"                      INTO var_oprn_narr
"
"                      FROM prod_transfeR_process
"
"                     WHERE ptp_bu = p_bu
"
"                       AND ptp_plnt = p_plnt
"
"                       AND ptp_trans_no = p_trans_no;
"
"
"
"                    v_dbt_store_id := p_rcpt_store;
"
"                    v_crd_store_id := func_find_store_fr_type(p_bu,p_plnt,NULL,'P');
"
"
"
"                    v_prod_desc1 := func_find_prod_desc(p_bu,p_prod_id,p_prod_rev,p_lang);
"
"
"
"                        OPEN c4(p_prod_id, p_prod_rev, v_crd_store_id , p_prod_ord_no , p_sf_code);
"
"
"
"                        fetch c4 INTO cr4;
"
"                        if c4%notfound then
"
"
"
"                       raise_application_error(-20999,'HRM' || v_sf_qty);
"
"                       end if;
"
"                       close C4;
"
"
"
"                    v_unit_cost := func_find_sfg_unitcost(p_bu,p_prod_id,p_prod_rev,v_crd_store_id,p_prod_ord_no,p_sf_code,p_sys_ls_no);
"
"
"
"                    OPEN c1(v_dbt_store_id);
"
"                    FETCH c1 INTO cr1;
"
"                    IF  cr1.store_gl_acct IS NULL THEN
"
"                        RAISE_APPLICATION_ERROR(-20269,'ICM'|| 'Warehouse GL Account not found'|| cr1.store_id);
"
"                    ELSE
"
"
"
"                         proc_find_cost_center (p_bu,
"
"                                                p_plnt,
"
"                                                NULL,
"
"                                                cr1.store_gl_acct,
"
"                                                NULL,
"
"                                                NULL,
"
"                                                NULL,
"
"                                                NULL,
"
"                                                v_dbt_lvl1,
"
"                                                v_dbt_lvl2,
"
"                                                v_dbt_lvl3,
"
"                                                v_dbt_lvl4,
"
"                                                v_dbt_lvl5,
"
"                                                v_dbt_lvl6,
"
"                                                v_acct_lvl_prj ,--p_acct_lvl_prj,
"
"                                                v_dbt_plnt,
"
"                                                v_dbt_cc_code,
"
"                                                v_dbt_loc_id
"
"                                                );
"
"
"
"                         --v_dbt_lvl1 := cr1.store_gl_lvl1;
"
"                         --v_dbt_lvl2 := cr1.store_gl_lvl2;
"
"                         --v_dbt_lvl3 := cr1.store_gl_lvl3;
"
"                         --v_dbt_lvl4 := cr1.store_gl_lvl4;
"
"                         v_dbt_acct := cr1.store_gl_acct;
"
"                         --v_dbt_plnt := cr1.store_acct_plnt;
"
"                    END IF;
"
"                    CLOSE c1;
"
"
"
"                    OPEN c1(v_crd_store_id);
"
"                    FETCH c1 INTO cr1;
"
"                    IF cr1.store_gl_acct IS NULL THEN
"
"                        RAISE_APPLICATION_ERROR(-20269,'ICM'|| 'Warehouse GL Account not found'||v_crd_store_id|| ' '|| cr1.store_id);
"
"                    ELSE
"
"                        proc_find_cost_center (p_bu,
"
"                                                p_plnt,
"
"                                                NULL,
"
"                                                cr1.store_gl_acct,
"
"                                                NULL,
"
"                                                NULL,
"
"                                                NULL,
"
"                                                NULL,
"
"                                                v_crd_lvl1,
"
"                                                v_crd_lvl2,
"
"                                                v_crd_lvl3,
"
"                                                v_crd_lvl4,
"
"                                                v_crd_lvl5,
"
"                                                v_crd_lvl6,
"
