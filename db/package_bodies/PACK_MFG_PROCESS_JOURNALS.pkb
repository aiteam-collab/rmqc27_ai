"                                                                            func_find_gl_acct_desc(p_bu,v_crd_acct,p_lang)           ,
"
"                                                                            'REJECTED STOCK DECREASE AT POST INSPECTION WAREHOUSE ('||p_trans_no||'/'||var_oprn_narr||' '||')'               ,
"
"                                                                            'REJECTED STOCK DECREASE AT POST INSPECTION WAREHOUSE'             ,
"
"                                                                            0              ,
"
"                                                                            ROUND((v_unit_cost * p_reject_qty),func_find_appl_rnddigit(p_bu)),
"
"                                                                            0              ,
"
"                                                                            ROUND((v_unit_cost * p_reject_qty),func_find_appl_rnddigit(p_bu)),
"
"                                                                            1             ,
"
"                                                                            1             ,
