"                                                                    'REJECTED STOCK INCREASE AT REJECTION STORE ('||p_trans_no ||'/' ||var_oprn_narr||' )'           ,
"
"                                                                    'REJECTED STOCK INCREASE AT REJECTION STORE'             ,
"
"                                                                    round((v_unit_cost * p_reject_qty),func_find_appl_rnddigit(p_bu)),
"
"                                                                    0              ,
"
"                                                                    round((v_unit_cost * p_reject_qty),func_find_appl_rnddigit(p_bu)),
"
"                                                                    0              ,
"
"                                                                    1             ,
"
"                                                                    1             ,
"
